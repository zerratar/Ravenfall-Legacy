/*
  Village build mode, after docs/mockups/build-*.webp. Dark glass panels with a gold top edge,
  NewRodin type, gold for actions, green for bonuses, red for anything destructive or invalid.
  Label rules use two classes to outrank the label reset just below.
*/

.rf-build .unity-label {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* ---- Fonts ---- */

.rf-build .rf-build-panel__title,
.rf-build .rf-build-caption,
.rf-build .rf-build-plot__title,
.rf-build .rf-build-plot__resident-name,
.rf-build .rf-build-bonuses__name,
.rf-build .rf-build-card__name,
.rf-build .rf-build-card__build,
.rf-build .rf-build-tab__label,
.rf-build .rf-build-tile__label,
.rf-build .rf-build-wide,
.rf-build .rf-build-wide__label,
.rf-build .rf-build-hall__need,
.rf-build .rf-build-hint,
.rf-build .rf-build-toast,
.rf-build .rf-plot__name,
.rf-build .rf-build-modal__title,
.rf-build .rf-build-current,
.rf-build .rf-build-assign__name,
.rf-build .rf-build-assign__tag,
.rf-build .rf-build-assign__button {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
}

.rf-build .rf-build-plot__bonus,
.rf-build .rf-build-bonuses__value,
.rf-build .rf-build-assign__bonus,
.rf-build .rf-build-placing__bonus {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
    -unity-font-style: normal;
}

/* ---- Panels ---- */

.rf-build-panel {
    background-color: var(--rf-surface-glass);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-width: 3px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-build-panel__head {
    flex-direction: row;
    align-items: center;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-2);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
}

/* Panel headers are drag handles, like every other HUD window. */
.rf-build-panel__head--drag {
    cursor: pan;
}

.rf-build .rf-build-panel__glyph {
    font-size: 22px;
    color: var(--rf-accent);
    margin-right: var(--rf-space-3);
}

.rf-build .rf-build-panel__title {
    flex-grow: 1;
    font-size: 22px;
    color: var(--rf-text);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-build .rf-build__close {
    font-size: 16px;
    color: var(--rf-text-dim);
}

.rf-build .rf-build__close:hover {
    color: var(--rf-text);
}

.rf-build .rf-build-caption {
    font-size: 13px;
    color: var(--rf-text-dim);
    letter-spacing: 1.2px;
}

/* The town hall's upgrade section: the next tier, what it needs (met in green, missing in red). */
.rf-build .rf-build-hall {
    margin-top: var(--rf-space-3);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
}

.rf-build .rf-build-hall .rf-build-wide {
    margin-left: 0;
    margin-right: 0;
}

.rf-build .rf-build-hall__needs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--rf-space-2);
}

.rf-build .rf-build-hall__need {
    font-size: 15px;
    color: var(--rf-danger);
    margin-right: var(--rf-space-4);
    margin-bottom: 4px;
}

.rf-build .rf-build-hall__need--met {
    color: var(--rf-success);
}

.rf-build .rf-build-wide.rf-build-wide--upgrade {
    color: var(--rf-accent);
    border-top-color: var(--rf-accent);
}

.rf-build .rf-build-note {
    font-size: 14px;
    color: var(--rf-text-dim);
    white-space: normal;
    margin-top: var(--rf-space-2);
}

/* ==========================================================================
   Markers
   ========================================================================== */

.rf-build__markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A 300px box centred on the point over the plot, so the pill can grow either way. */
.rf-plot {
    position: absolute;
    left: 0;
    top: 0;
    width: 300px;
    height: 56px;
    margin-left: -150px;
    margin-top: -56px;
    align-items: center;
    justify-content: flex-end;
}

/* A built plot: icon ring plus name, as a pill. */
.rf-plot__pill {
    flex-direction: row;
    align-items: center;
    padding-right: 14px;
    background-color: var(--rf-surface-glass);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.12s;
    cursor: link;
}

.rf-plot__pill:hover {
    scale: 1.06 1.06;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-plot__ring {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
}

.rf-plot__icon {
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-build .rf-plot__plus {
    font-size: 20px;
    color: var(--rf-text-on-accent);
}

.rf-build .rf-plot__name {
    font-size: 15px;
    color: var(--rf-text);
    white-space: nowrap;
    text-shadow: 1px 1px 1px var(--rf-text-shadow-strong);
}

/* An empty plot is just the ring: a gold disc with a plus, as in the mockups. */
.rf-plot--empty .rf-plot__pill {
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-plot--empty .rf-plot__ring {
    margin-right: 0;
    background-color: var(--rf-accent);
    border-left-color: rgb(40, 32, 20);
    border-right-color: rgb(40, 32, 20);
    border-top-color: rgb(40, 32, 20);
    border-bottom-color: rgb(40, 32, 20);
}

.rf-plot--selected .rf-plot__pill {
    background-color: var(--rf-accent-dim);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

.rf-plot--selected.rf-plot--empty .rf-plot__ring {
    scale: 1.2 1.2;
    background-color: var(--rf-accent-bright);
}

/* A building is armed: empty plots are targets, the rest step back. */
.rf-plot--target .rf-plot__ring {
    background-color: var(--rf-success);
}

.rf-plot--muted {
    opacity: 0.35;
}

.rf-plot--moving .rf-plot__pill {
    background-color: rgba(76, 195, 138, 0.85);
    border-left-color: var(--rf-success);
    border-right-color: var(--rf-success);
    border-top-color: var(--rf-success);
    border-bottom-color: var(--rf-success);
}

/* Moving to a spot that is not allowed: the pill says why, in red. */
.rf-plot--moving-blocked .rf-plot__pill {
    background-color: rgba(150, 30, 30, 0.92);
    border-left-color: rgb(255, 120, 110);
    border-right-color: rgb(255, 120, 110);
    border-top-color: rgb(255, 120, 110);
    border-bottom-color: rgb(255, 120, 110);
}

.rf-plot--moving-blocked .rf-plot__ring {
    background-color: var(--rf-danger);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

/* ==========================================================================
   Village bonuses (left)
   ========================================================================== */

.rf-build-bonuses {
    position: absolute;
    left: 24px;
    top: 120px;
    width: 420px;
}

.rf-build-bonuses__chevron {
    margin-right: 0;
}

.rf-build-bonuses--collapsed .rf-build-bonuses__body {
    display: none;
}

.rf-build-bonuses--collapsed .rf-build-bonuses__chevron {
    rotate: 45deg;
    translate: 0 -2px;
}

.rf-build-bonuses__body {
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-bottom: var(--rf-space-2);
    border-top-width: 1px;
    border-top-color: var(--rf-divider);
}

.rf-build-bonuses__row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rf-divider);
}

.rf-build-bonuses__icon {
    width: 40px;
    height: 40px;
    margin-left: 4px;
    margin-right: var(--rf-space-3);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-build-bonuses__text {
    flex-grow: 1;
}

.rf-build-bonuses__line {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rf-build .rf-build-bonuses__name {
    font-size: 17px;
    color: var(--rf-text);
}

.rf-build .rf-build-bonuses__value {
    font-size: 20px;
    color: var(--rf-accent-bright);
}

.rf-build-bonuses__bar {
    flex-grow: 1;
    height: 8px;
    margin-right: var(--rf-space-3);
    background-color: var(--rf-bar-track);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.rf-build-bonuses__fill {
    height: 100%;
    background-color: var(--rf-accent);
}

.rf-build .rf-build-bonuses__count {
    font-size: 13px;
    color: var(--rf-text-dim);
}

.rf-build-bonuses__meter {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.rf-build .rf-build-bonuses__footer {
    font-size: 14px;
    color: var(--rf-text-dim);
    margin-top: var(--rf-space-3);
    margin-left: 4px;
}

/* ==========================================================================
   Selected building (right)
   ========================================================================== */

.rf-build-plot {
    position: absolute;
    right: 24px;
    top: 120px;
    width: 470px;
    padding-bottom: var(--rf-space-4);
}

.rf-build-ring {
    width: 56px;
    height: 56px;
    margin-right: var(--rf-space-3);
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.rf-build-ring__icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-build .rf-build-ring__glyph {
    font-size: 22px;
    color: var(--rf-accent);
}

.rf-build-plot__titles {
    flex-grow: 1;
}

.rf-build .rf-build-plot__title {
    font-size: 26px;
    color: var(--rf-text);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-build .rf-build-plot__subtitle {
    font-size: 14px;
    color: var(--rf-text-dim);
    margin-top: 2px;
}

.rf-build-plot__built,
.rf-build-plot > .rf-build-note {
    margin-left: var(--rf-space-4);
    margin-right: var(--rf-space-4);
    padding-top: var(--rf-space-3);
    border-top-width: 1px;
    border-top-color: var(--rf-divider);
}

.rf-build-plot__resident {
    margin-top: var(--rf-space-2);
}

.rf-build .rf-build-plot__resident-name {
    font-size: 22px;
    color: var(--rf-text);
}

.rf-build .rf-build-plot__resident-level {
    font-size: 15px;
    color: var(--rf-text-dim);
    margin-top: 2px;
}

.rf-build .rf-build-plot__bonus {
    font-size: 32px;
    color: var(--rf-accent-bright);
    margin-top: var(--rf-space-2);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

/* ---- Action tiles ---- */

.rf-build-tiles {
    flex-direction: row;
    margin-top: var(--rf-space-4);
    margin-left: 12px;
    margin-right: 12px;
}

.rf-build .rf-build-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 84px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    cursor: link;
}

.rf-build .rf-build-tile:hover {
    background-color: var(--rf-accent-wash);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-build .rf-build-tile:disabled {
    opacity: 0.4;
}

.rf-build .rf-build-tile__icon {
    font-size: 26px;
    color: var(--rf-text);
}

.rf-build .rf-build-tile__label {
    margin-top: 8px;
    font-size: 14px;
    color: var(--rf-text);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---- Wide buttons ---- */

.rf-build .rf-build-wide {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 48px;
    margin-left: var(--rf-space-4);
    margin-right: var(--rf-space-4);
    margin-top: var(--rf-space-2);
    margin-bottom: 0;
    font-size: 16px;
    color: var(--rf-text);
    background-color: rgba(0, 0, 0, 0.3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    cursor: link;
}

.rf-build .rf-build-wide:hover {
    background-color: var(--rf-row-hover);
}

.rf-build .rf-build-wide--danger {
    margin-top: var(--rf-space-3);
    background-color: rgb(110, 26, 30);
    border-left-color: rgb(170, 48, 52);
    border-right-color: rgb(170, 48, 52);
    border-top-color: rgb(170, 48, 52);
    border-bottom-color: rgb(170, 48, 52);
}

.rf-build .rf-build-wide--danger:hover {
    background-color: rgb(140, 32, 36);
}

/* Second click needed. */
.rf-build .rf-build-wide--confirm {
    background-color: var(--rf-danger);
}

.rf-build .rf-build-wide__icon {
    font-size: 18px;
    color: rgb(255, 210, 205);
    margin-right: var(--rf-space-3);
}

.rf-build .rf-build-wide__label {
    font-size: 20px;
    color: rgb(255, 225, 220);
}

.rf-build .rf-build-wide:disabled {
    opacity: 0.4;
}

/* ==========================================================================
   Placing card (bottom right)
   ========================================================================== */

.rf-build-placing {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 300px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
}

.rf-build-placing__row {
    flex-direction: row;
    align-items: center;
}

.rf-build-placing__icon {
    width: 56px;
    height: 56px;
    margin-right: var(--rf-space-3);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-build .rf-build-placing__bonus {
    font-size: 16px;
    color: var(--rf-success);
    margin-top: 2px;
}

/* ==========================================================================
   Bottom: hint, tray, toolbar
   ========================================================================== */

.rf-build-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    align-items: center;
}

.rf-build .rf-build-hint {
    font-size: 15px;
    color: var(--rf-text);
    background-color: var(--rf-surface-glass);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: var(--rf-space-3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.rf-build-tray {
    margin-bottom: var(--rf-space-3);
}

.rf-build-tray__cards {
    flex-direction: row;
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
}

.rf-build-card {
    width: 250px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.3);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-accent-dim);
    border-right-color: var(--rf-accent-dim);
    border-top-color: var(--rf-accent-dim);
    border-bottom-color: var(--rf-accent-dim);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    transition-property: translate, border-color;
    transition-duration: 0.12s;
}

.rf-build-card:hover {
    translate: 0 -4px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-build-card--armed {
    background-color: var(--rf-accent-wash);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

.rf-build-card--current {
    border-left-color: var(--rf-success);
    border-right-color: var(--rf-success);
    border-top-color: var(--rf-success);
    border-bottom-color: var(--rf-success);
}

.rf-build-card--disabled {
    opacity: 0.5;
}

.rf-build-card__preview {
    height: 140px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 244, 214, 0.04);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-build-card__info {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.rf-build-card__ring {
    width: 44px;
    height: 44px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.rf-build-card__icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-build .rf-build-card__name {
    font-size: 17px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-build .rf-build-card__bonus {
    font-size: 14px;
    color: var(--rf-success);
    margin-top: 2px;
}

.rf-build .rf-build-card__build {
    height: 40px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 12px;
    margin-bottom: 0;
    font-size: 18px;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    cursor: link;
}

.rf-build .rf-build-card__build:hover {
    background-color: var(--rf-accent-bright);
}

.rf-build-toolbar {
    flex-direction: row;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.rf-build .rf-build-tab {
    width: 112px;
    height: 84px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    cursor: link;
}

.rf-build .rf-build-tab:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

/* The open category: solid gold, dark text, as in the mockups. */
.rf-build .rf-build-tab--active {
    background-color: var(--rf-accent);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

.rf-build .rf-build-tab__icon {
    font-size: 30px;
    color: var(--rf-text);
}

.rf-build .rf-build-tab__label {
    margin-top: 8px;
    font-size: 15px;
    color: var(--rf-text);
}

.rf-build .rf-build-tab--active .rf-build-tab__icon,
.rf-build .rf-build-tab--active .rf-build-tab__label {
    color: var(--rf-text-on-accent);
}

/* While moving, the tray and toolbar step back: the world is what matters. */
.rf-build--moving .rf-build-tray,
.rf-build--moving .rf-build-toolbar {
    opacity: 0.35;
}

/* ==========================================================================
   Toast
   ========================================================================== */

/* Messages: a red chip centred under the top bar, impossible to miss. */
.rf-build .rf-build-toast {
    position: absolute;
    top: 180px;
    align-self: center;
    font-size: 18px;
    color: rgb(255, 235, 230);
    background-color: rgba(120, 26, 30, 0.95);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 120, 110);
    border-right-color: rgb(255, 120, 110);
    border-top-color: rgb(255, 120, 110);
    border-bottom-color: rgb(255, 120, 110);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.rf-build .rf-build-toast--visible {
    opacity: 1;
}

/* ==========================================================================
   Resident picker
   ========================================================================== */

.rf-build-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.rf-build-modal__panel {
    width: 820px;
    height: 620px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
}

.rf-build-modal__head {
    flex-direction: row;
    align-items: center;
    padding-top: var(--rf-space-2);
}

.rf-build .rf-build-modal__title {
    flex-grow: 1;
    font-size: 28px;
    color: var(--rf-text);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-build-modal__tools {
    flex-direction: row;
    align-items: center;
    margin-top: var(--rf-space-4);
}

/* Search field: Unity's TextField restyled to the dark panels. */
.rf-build-search {
    flex-grow: 1;
    margin-left: 0;
    margin-right: var(--rf-space-3);
    margin-top: 0;
    margin-bottom: 0;
}

.rf-build-search > .unity-text-field__input,
.rf-build-search .unity-base-text-field__input {
    height: 44px;
    padding-left: 14px;
    font-size: 17px;
    color: var(--rf-text);
    background-color: rgba(0, 0, 0, 0.45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-build .rf-build-current {
    height: 44px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 16px;
    color: var(--rf-text);
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-build-assign {
    flex-grow: 1;
    margin-top: var(--rf-space-3);
}

.rf-build-assign__row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-3);
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-build-assign .rf-build-assign__row.unity-collection-view__item:hover {
    background-color: var(--rf-row-hover);
}

.rf-build-assign__row--best {
    background-color: var(--rf-highlight-wash);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-build-assign__text {
    flex-grow: 1;
}

.rf-build-assign__line {
    flex-direction: row;
    align-items: center;
}

.rf-build .rf-build-assign__name {
    font-size: 19px;
    color: var(--rf-text);
}

.rf-build .rf-build-assign__tag {
    margin-left: var(--rf-space-3);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 12px;
    color: var(--rf-text-dim);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-build .rf-build-assign__tag--best {
    color: var(--rf-accent-bright);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-build .rf-build-assign__level {
    font-size: 14px;
    color: var(--rf-text-dim);
    margin-top: 2px;
}

.rf-build .rf-build-assign__bonus {
    font-size: 19px;
    color: var(--rf-success);
    margin-right: var(--rf-space-4);
}

.rf-build .rf-build-assign__button {
    width: 120px;
    height: 42px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 17px;
    color: var(--rf-text);
    background-color: rgba(0, 0, 0, 0.3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    cursor: link;
}

.rf-build .rf-build-assign__button:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-build-assign__row--best .rf-build-assign__button {
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-build .rf-build-assign__button:disabled {
    opacity: 0.4;
}

/* Far from the camera, built plots show just their icon, so a village of thirty buildings is not a
   wall of labels. Hovering shows the name again. */
.rf-plot--far .rf-plot__pill {
    padding-right: 0;
}

.rf-plot--far .rf-plot__ring {
    margin-right: 0;
}

.rf-plot--far .rf-plot__name {
    display: none;
}

.rf-plot--far .rf-plot__pill:hover {
    padding-right: 14px;
}

.rf-plot--far .rf-plot__pill:hover .rf-plot__ring {
    margin-right: 10px;
}

.rf-plot--far .rf-plot__pill:hover .rf-plot__name {
    display: flex;
}

.rf-plot--no-name .rf-plot__name,
.rf-plot--no-name .rf-plot__pill:hover .rf-plot__name {
    display: none;
}

/* ---- Roads ---- */

/* The road card shows a patch of the road's surface where house cards show the house. */
.rf-build-road-swatch {
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
}

.rf-build-card--locked {
    opacity: 0.55;
}

.rf-build-road__types {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--rf-space-3);
}

.rf-build .rf-build-road-chip {
    height: 34px;
    margin-left: 0;
    margin-right: var(--rf-space-2);
    margin-top: 0;
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    font-size: 14px;
    color: var(--rf-text);
    background-color: var(--rf-surface-raised);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.rf-build .rf-build-road-chip:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-build .rf-build-road-chip--current {
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

/* A road through a building: said in words as well as the red road. */
.rf-build .rf-build-road__flag {
    color: var(--rf-danger);
    -unity-font-style: bold;
}

