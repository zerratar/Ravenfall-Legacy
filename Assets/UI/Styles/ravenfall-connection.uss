/* ==========================================================================
   Chat connection warning
   A chip in the bottom left corner, there only while chat cannot reach the game. The icon says
   which part is down (the robot for the bot, the Twitch glitch for the channel), a dot on it says
   how bad, and the text says it in words, so neither colour nor icon has to carry it alone.
   ========================================================================== */

.rf-conn-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Bottom left, growing upwards: the server pill sits above the chat chip when both show. */
.rf-conn-stack {
    position: absolute;
    left: var(--rf-space-4);
    bottom: var(--rf-space-4);
    align-items: flex-start;
}

.rf-conn {
    flex-direction: row;
}

.rf-conn__chip {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 6px;
    padding-right: var(--rf-space-4);
    background-color: rgba(20, 18, 15, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.rf-conn__chip:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

/* The round badge holding the icon, with the state dot on its lower right. */
.rf-conn__badge {
    width: 30px;
    height: 30px;
    margin-right: var(--rf-space-2);
    align-items: center;
    justify-content: center;
    background-color: var(--rf-surface-raised);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.rf-conn .rf-conn__icon {
    font-size: 15px;
    color: var(--rf-text);
}

.rf-conn__dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 11px;
    height: 11px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(20, 18, 15);
    border-right-color: rgb(20, 18, 15);
    border-top-color: rgb(20, 18, 15);
    border-bottom-color: rgb(20, 18, 15);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--rf-text-faint);
}

.rf-conn .rf-conn__text {
    font-size: 15px;
    color: var(--rf-text);
    -unity-font-style: bold;
}

/* ---- States ---- */

.rf-conn__chip--offline .rf-conn__dot {
    background-color: var(--rf-danger);
}

.rf-conn__chip--offline .rf-conn__badge {
    background-color: rgba(229, 72, 77, 0.22);
}

.rf-conn__chip--connecting .rf-conn__dot {
    background-color: var(--rf-warning);
}

.rf-conn__chip--connecting .rf-conn__text {
    color: var(--rf-text-dim);
}

/* Twitch's own purple for the channel, so it reads as Twitch at a glance. */
.rf-conn__chip--chat .rf-conn__badge {
    background-color: rgb(145, 70, 255);
}

.rf-conn__chip--chat .rf-conn__icon {
    color: rgb(255, 255, 255);
}

.rf-conn__chip--chat .rf-conn__dot {
    background-color: var(--rf-warning);
}

/* ---- The server link ----
   A card in the corner rather than a red band across the whole bottom edge: it says the same,
   covers nothing, and the second line says what to do (wait, do not restart). */

.rf-conn-server {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    background-color: rgba(20, 18, 15, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-danger);
    border-right-color: var(--rf-danger);
    border-top-color: var(--rf-danger);
    border-bottom-color: var(--rf-danger);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-conn-server .rf-conn-server__icon {
    width: 38px;
    height: 38px;
    margin-right: var(--rf-space-3);
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: var(--rf-danger);
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
}

.rf-conn-server__body {
    /* a set width: a shrinking label re-measured its wrap and left a gap after the first line */
    width: 420px;
}

/* Labels bring margins and padding of their own; both lines set theirs, so the gap between
   them is the 2px here and nothing else. */
.rf-conn-server .rf-conn-server__title,
.rf-conn-server .rf-conn-server__note {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.rf-conn-server .rf-conn-server__title {
    margin-bottom: 2px;
    font-size: 17px;
    color: var(--rf-text);
    -unity-font-style: bold;
}

.rf-conn-server .rf-conn-server__note {
    font-size: 14px;
    color: var(--rf-text-dim);
    white-space: normal;
}

/* An update waiting is news, not trouble: amber rather than red. */
.rf-conn-server--outdated {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-conn-server--outdated .rf-conn-server__icon {
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
}
