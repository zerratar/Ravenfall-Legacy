/*
 * Shared Ravenfall UI components.
 *
 * Everything here reads from ravenfall-tokens.uss. If a screen needs a value that is not a token,
 * that is a signal the token set is missing something, not a reason to hard code it locally.
 */

/* ---- layout primitives ------------------------------------------------- */

.rf-screen {
    flex-grow: 1;
    background-color: var(--rf-bg);
    align-items: center;
    justify-content: center;
}

.rf-panel {
    background-color: var(--rf-surface);
    border-left-width: var(--rf-border-width);
    border-right-width: var(--rf-border-width);
    border-top-width: var(--rf-border-width);
    border-bottom-width: var(--rf-border-width);
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    padding-left: var(--rf-space-5);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-5);
    padding-bottom: var(--rf-space-5);
}

.rf-stack {
    flex-direction: column;
}

.rf-row {
    flex-direction: row;
    align-items: center;
}

.rf-spacer {
    flex-grow: 1;
}

/* ---- text -------------------------------------------------------------- */

.rf-text {
    color: var(--rf-text);
    font-size: var(--rf-font-body);
    -unity-font-style: bold;
    white-space: normal;
}

.rf-text--dim {
    color: var(--rf-text-dim);
}

.rf-text--faint {
    color: var(--rf-text-faint);
}

.rf-text--caption {
    font-size: var(--rf-font-caption);
    letter-spacing: 1px;
}

.rf-text--title {
    font-size: var(--rf-font-title);
}

.rf-text--heading {
    font-size: var(--rf-font-heading);
}

.rf-text--display {
    font-size: var(--rf-font-display);
}

.rf-text--center {
    -unity-text-align: middle-center;
}

.rf-text--danger {
    color: var(--rf-danger);
}

.rf-text--success {
    color: var(--rf-success);
}

/* ---- brand -------------------------------------------------------------
 * The Ravenfall logotype. Kept as an image rather than set type: it is the
 * one piece of the interface that should not be re-drawn by a stylesheet.
 * Sized from the original uGUI screen (471 x 193) and scaled to fit so the
 * aspect ratio holds however the panel resizes.
 */

.rf-logo {
    background-image: url("project://database/Assets/Sprites/logo.png");
    -unity-background-scale-mode: scale-to-fit;
    width: 420px;
    height: 172px;
    align-self: center;
}

/* ---- progress bar ------------------------------------------------------
 * Solid fill on a solid track. No gradient, no thin outline: both are the
 * first things a video encoder destroys.
 */

.rf-progress {
    height: 28px;
    background-color: var(--rf-bg);
    border-left-width: var(--rf-border-width);
    border-right-width: var(--rf-border-width);
    border-top-width: var(--rf-border-width);
    border-bottom-width: var(--rf-border-width);
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    overflow: hidden;
    justify-content: center;
}

.rf-progress__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--rf-accent);
}

.rf-progress__label {
    -unity-text-align: middle-center;
    font-size: var(--rf-font-caption);
    -unity-font-style: bold;
    color: var(--rf-text);
}

/* ---- buttons ----------------------------------------------------------- */

.rf-button {
    background-color: var(--rf-surface-raised);
    color: var(--rf-text);
    font-size: var(--rf-font-body);
    -unity-font-style: bold;
    border-left-width: var(--rf-border-width);
    border-right-width: var(--rf-border-width);
    border-top-width: var(--rf-border-width);
    border-bottom-width: var(--rf-border-width);
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    min-height: 40px;
}

/*
 * Every state sets BOTH background and text colour, never just one.
 *
 * Setting only the background is how the primary button ended up unreadable on hover: the base
 * hover rule swapped the background while the primary variant's dark text colour stayed put,
 * leaving dark on dark. A state that changes one half of a contrast pair has to change the other.
 *
 * Selectors are doubled up (.rf-button.rf-button--primary) so they outrank both the base hover
 * rule and Unity's default .unity-button theme, which also styles hover and would otherwise win
 * on ordering alone.
 */

.rf-button:hover {
    background-color: var(--rf-border);
    color: var(--rf-text);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-button:active {
    background-color: var(--rf-accent);
    color: var(--rf-text-on-accent);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

/* Primary: dark text on amber, at every state. The background only ever gets lighter or
 * slightly dimmer, so the dark text stays legible throughout. */

.rf-button.rf-button--primary {
    background-color: var(--rf-accent);
    color: var(--rf-text-on-accent);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

.rf-button.rf-button--primary:hover {
    background-color: var(--rf-accent-bright);
    color: var(--rf-text-on-accent);
}

.rf-button.rf-button--primary:active {
    background-color: var(--rf-accent-dim);
    color: var(--rf-text);
}

/* ---- scroll regions ----------------------------------------------------
 * Long body text, for example the code of conduct. The track is darker than
 * the panel so the scrollable area reads as inset rather than floating.
 */

.rf-scroll {
    background-color: var(--rf-bg);
    border-left-width: var(--rf-border-width);
    border-right-width: var(--rf-border-width);
    border-top-width: var(--rf-border-width);
    border-bottom-width: var(--rf-border-width);
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
}

/* ---- scrollbars --------------------------------------------------------
 * UI Toolkit's default scroller is a thin light control from Unity's own
 * theme, which looks wrong on a dark panel and is close to invisible once a
 * stream encoder has been at it.
 *
 * Deliberately chunky: 14px of track. A 4px scrollbar is fine on a monitor
 * at arm's length and gone entirely at 720p on a phone. The stepper arrows
 * are hidden because they are too small to hit and add visual noise.
 */

.unity-scroll-view__vertical-scroller,
.unity-scroll-view__horizontal-scroller {
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.unity-scroll-view__vertical-scroller {
    width: 14px;
}

.unity-scroll-view__horizontal-scroller {
    height: 14px;
}

/* the stepper arrows at each end */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller .unity-base-slider {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: var(--rf-bg);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    margin-left: 0;
    margin-right: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-color: var(--rf-border-strong);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    width: 10px;
    margin-left: 2px;
    margin-right: 2px;
}

.unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--rf-accent);
}

.unity-scroller .unity-base-slider--horizontal .unity-base-slider__dragger {
    height: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* the corner where two scrollers meet */
.unity-scroll-view__content-viewport {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* ---- notifications -----------------------------------------------------
 * Arena, raid and dungeon announcements. These replace seven pre-rendered
 * PNGs that had their English wording painted in, which could not be
 * translated and had to be redrawn by hand on every style change.
 *
 * The root paints nothing: notifications sit over gameplay. The card uses a
 * scrim so the world still reads underneath while the text stays legible
 * after compression.
 */

.rf-notify-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: flex-start;
}

.rf-notify {
    background-color: var(--rf-overlay-scrim);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    padding-left: var(--rf-space-7);
    padding-right: var(--rf-space-7);
    padding-top: var(--rf-space-5);
    padding-bottom: var(--rf-space-5);
    margin-top: var(--rf-space-7);
    align-items: center;
    min-width: 60%;
}

/* The headline.
 *
 * The original PNGs used a heavy italic script with a hard drop shadow. The face itself is not
 * worth reproducing, it is a large part of why these screens never matched anything else, but two
 * of its choices were right and are kept:
 *
 *   italic, because an announcement should read as an event rather than a label
 *   a drop shadow, which is not decoration here: these sit over arbitrary game scenery, and a
 *   shadow is what keeps light text legible against a bright sky or a snow island
 *
 * Sized at display rather than heading. A viewer is glancing at this while reading chat, often at
 * 720p on a phone, so it needs to land in one look.
 */
.rf-notify__title {
    font-size: var(--rf-font-display);
    color: var(--rf-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

/* Wins and draws. The originals put "Draw" in gold; the accent carries that
 * without introducing another colour into the system. */
.rf-notify__title--reward {
    color: var(--rf-accent);
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.95);
}

.rf-notify__line {
    font-size: var(--rf-font-title);
    color: var(--rf-text);
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: var(--rf-space-2);
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.85);
}

/* The second line is supporting detail, so it steps down rather than
 * competing with the join instruction above it. */
.rf-notify__line--secondary {
    font-size: var(--rf-font-body);
    color: var(--rf-text-dim);
}

.rf-command {
    color: var(--rf-accent);
    -unity-font-style: bold;
}
