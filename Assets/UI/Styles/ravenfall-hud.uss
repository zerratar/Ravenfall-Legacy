/*
  Ravenfall in game HUD.

  Matches the reference mockups in docs/mockups. Colours come from ravenfall-tokens.uss.

  This is stream UI, so it carries one constraint the website does not: it is watched through
  Twitch's encoder at 720p or 1080p over a moving 3D scene. Thin strokes, low contrast edges and
  small text fall apart under that compression. So panels are nearly opaque, borders are at least
  2px where they carry meaning, important text carries an outline as well as a shadow, and nothing
  that matters is small.

  Type is FOT-NewRodin Pro, the face the rest of the game's UI already uses, so new and old screens
  read as one game. Weight is chosen by font file rather than faked with bold: M for running text,
  B for names and labels, EB for the numbers a viewer reads at a glance. Icons are Font Awesome 5
  Pro Solid, drawn by codepoint.
*/

/* ==========================================================================
   Fonts
   ========================================================================== */

.rf-window-layer,
.rf-top-layer {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20M.otf?fileID=12800000&guid=13c778c6119df5b498e1a3cabdbc6c0e&type=3#FOT-NewRodin Pro M");
}

.rf-icon {
    -unity-font-definition: url("project://database/Assets/Fonts/FontAwesome7/Font%20Awesome%207%20Pro-Solid-900.otf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* Font Awesome's brand icons live in their own font. */
.rf-icon.rf-icon--brand {
    -unity-font-definition: url("project://database/Assets/Fonts/FontAwesome7/Font%20Awesome%207%20Brands-Regular-400.otf");
}

/* Bold weight, applied by class so the real B cut is used rather than a synthesised bold. */
.rf-font-b,
.rf-window .rf-window__title,
.rf-window .rf-window__badge,
.rf-player-row .rf-player-row__name,
.rf-player-row .rf-player-row__percent,
.rf-player-row .rf-player-row__rate,
.rf-top-layer .rf-boost__label,
.rf-top-layer .rf-boost__time,
.rf-raid .rf-raid__level,
.rf-raid .rf-raid__timer,
.rf-raid .rf-raid__hp,
.rf-raid .rf-raid__raiders {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
}

/* Extra bold, for the numbers people glance at. */
.rf-font-eb,
.rf-player-row .rf-player-row__level,
.rf-raid .rf-raid__title,
.rf-raid .rf-raid__percent,
.rf-raid .rf-raid__announce {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
    -unity-font-style: normal;
}

/* Unity's default theme gives every Label padding and margin. In dense rows that opened gaps,
   floated captions away from their numbers, and pushed rows past their fixed height, where the
   ListView item clips them. Zeroed here so the rules below are the only thing deciding spacing.
   Two classes, so it outranks the theme's one. Rules below that set label spacing also use two
   classes and win by coming later. */
.rf-window .unity-label,
.rf-top-layer .unity-label {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* ==========================================================================
   Window chrome
   ========================================================================== */

/* The full screen layer windows live in. Ignores picking so the world underneath stays clickable
   everywhere the windows are not. */
.rf-window-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rf-window {
    position: absolute;
    background-color: var(--rf-surface-glass);
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    /* The gold top edge from the mockups. It is the one ornament on the window, and it marks the
       window as part of the game's HUD rather than a generic panel. */
    border-top-color: var(--rf-accent);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    overflow: hidden;
}

.rf-window__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 44px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-2);
    background-color: var(--rf-surface-raised);
    border-bottom-color: var(--rf-divider);
    border-bottom-width: 1px;
    /* Signals the whole strip is grabbable. */
}

.rf-window .rf-window__title {
    font-size: 17px;
    color: var(--rf-text);
    letter-spacing: 1.5px;
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-window__header-actions {
    flex-direction: row;
    align-items: center;
}

.rf-window .rf-window__badge {
    font-size: 15px;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    min-width: 30px;
    height: 24px;
    padding-left: var(--rf-space-2);
    padding-right: var(--rf-space-2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    -unity-text-align: middle-center;
}

/* Header buttons. Unity's Button arrives with editor styling: a grey fill, a border, padding and
   margin. All of it is cleared so the button is just its icon until hovered. Every state sets both
   background and icon colour, since changing only one is how hover states end up unreadable. */
.rf-window__button {
    width: 30px;
    height: 30px;
    margin-left: var(--rf-space-2);
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    align-items: center;
    justify-content: center;
}

.rf-window__button:hover {
    background-color: var(--rf-accent-wash);
}

.rf-window__button:active {
    background-color: var(--rf-accent-dim);
}

/* A chevron drawn from two borders and a rotation, so it needs no glyph or image. Points up while
   expanded and turns to point down when collapsed. */
.rf-chevron {
    width: 9px;
    height: 9px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: var(--rf-text);
    border-bottom-color: var(--rf-text);
    rotate: -135deg;
    translate: 0 2px;
    transition-property: rotate, translate, border-color;
    transition-duration: 0.2s, 0.2s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.rf-window__button:hover .rf-chevron {
    border-right-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

.rf-window--collapsed .rf-chevron {
    rotate: 45deg;
    translate: 0 -2px;
}

.rf-window__body {
    flex-grow: 1;
}

.rf-window__footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 34px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-6);
    border-top-color: var(--rf-divider);
    border-top-width: 1px;
}

.rf-window .rf-window__footer-text {
    font-size: 14px;
    color: var(--rf-text-dim);
}

.rf-window--collapsed .rf-window__body,
.rf-window--collapsed .rf-window__footer,
.rf-window--collapsed .rf-window__grip {
    display: none;
}

.rf-window--collapsed .rf-window__header {
    border-bottom-width: 0;
}

/* Resize grip: an L drawn from two borders in the bottom right corner. */
.rf-window__grip {
    position: absolute;
    right: 5px;
    bottom: 5px;
    width: 14px;
    height: 14px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: var(--rf-text-faint);
    border-bottom-color: var(--rf-text-faint);
    border-bottom-right-radius: 2px;
}

.rf-window__grip:hover {
    border-right-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

/* A window that only grows sideways, its height following its content: a pill on the middle of
   the side edge, so the corner L does not promise a height it will not take. Visible at rest, so a
   streamer can find it, and lit when the window is pointed at. */
.rf-window__grip--width {
    right: 3px;
    bottom: auto;
    top: 50%;
    width: 7px;
    height: 64px;
    translate: 0 -50%;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--rf-text-faint);
    opacity: 0.55;
}

.rf-window:hover .rf-window__grip--width,
.rf-build-panel:hover .rf-window__grip--width {
    opacity: 0.9;
}

.rf-window__grip--width:hover {
    background-color: var(--rf-accent);
    opacity: 1;
}

/* The same on the left edge, for windows that sit against the right of the screen. */
.rf-window__grip--left {
    right: auto;
    left: 3px;
}

/* ==========================================================================
   Player list
   ========================================================================== */

.rf-playerlist__close {
    font-size: 16px;
    color: var(--rf-text-dim);
}

.rf-playerlist__close:hover {
    color: var(--rf-text);
}

/* Player search: a field under the header, Unity's TextField restyled to the dark panels. */
.rf-playerlist__search {
    flex-shrink: 0;
    padding-left: var(--rf-space-2);
    padding-right: var(--rf-space-2);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--rf-border);
}

.rf-playerlist__search-field {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.rf-playerlist__search-field > .unity-text-field__input,
.rf-playerlist__search-field .unity-base-text-field__input {
    height: 36px;
    padding-left: 12px;
    font-size: 16px;
    color: var(--rf-text);
    background-color: rgba(0, 0, 0, 0.45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-playerlist__search-field:focus > .unity-text-field__input,
.rf-playerlist__search-field:focus .unity-base-text-field__input {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-playerlist__search-empty {
    margin-top: var(--rf-space-2);
    font-size: 14px;
    color: var(--rf-text-dim);
    white-space: normal;
}

/* The magnifier lights up while a search is open. */
.rf-playerlist__search-toggle--active {
    color: var(--rf-accent);
}

.rf-playerlist {
    background-color: rgba(0, 0, 0, 0);
}

/* ListView prints "List is empty" with no rows, which would end up on stream. The badge already
   says zero. */
.rf-playerlist .unity-list-view__empty-label {
    display: none;
}

.rf-playerlist .unity-scroller--vertical {
    width: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
}

.rf-playerlist .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-playerlist .unity-base-slider__dragger {
    background-color: var(--rf-border-strong);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    width: 5px;
    margin-left: 1px;
}

.rf-playerlist .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--rf-accent-dim);
}

.rf-playerlist .unity-scroller__low-button,
.rf-playerlist .unity-scroller__high-button {
    display: none;
}

/* ---- Row ------------------------------------------------------------------ */

.rf-player-row {
    flex-direction: row;
    align-items: center;
    height: 96px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    border-bottom-color: var(--rf-divider);
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate, background-color;
    transition-duration: 0.18s, 0.18s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.rf-player-row--alt {
    background-color: var(--rf-row-alt);
}

/* Overrides Unity's default ListView hover, a flat light grey wash that killed the contrast on the
   name and the gold level. More specific than the theme's own rule, so it wins regardless of which
   stylesheet the panel resolves first. */
.rf-playerlist .rf-player-row.unity-collection-view__item:hover {
    background-color: var(--rf-row-hover);
}

.rf-playerlist .rf-player-row.unity-collection-view__item--selected,
.rf-playerlist .rf-player-row.unity-collection-view__item:checked {
    background-color: rgba(0, 0, 0, 0);
}

/* The player the camera is following: a gold edge and a warm wash. */
.rf-playerlist .rf-player-row.rf-player-row--highlight {
    background-color: var(--rf-highlight-wash);
    border-left-color: var(--rf-accent);
}

/* Entry animation, short because this is peripheral UI on a stream. The class is added on bind and
   removed a frame later, so the transition above plays. */
.rf-player-row--entering {
    opacity: 0;
    translate: 14px 0;
}

.rf-player-row__main {
    flex-grow: 1;
    /* Without this a long name pushes the level column off the row. */
    min-width: 0;
    overflow: hidden;
}

.rf-player-row__line {
    flex-direction: row;
    align-items: center;
}

.rf-player-row .rf-player-row__name {
    font-size: 22px;
    color: var(--rf-text);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* An outline as well as a shadow. It keeps a hard edge on every glyph whatever the scene behind
       is doing, and survives the stream encoder far better than a blur alone. */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--rf-text-outline);
    text-shadow: 1px 2px 2px var(--rf-text-shadow-strong);
}

/* Neutral rather than gold: rested is information, not an achievement. */
.rf-player-row .rf-player-row__rested {
    font-size: 13px;
    color: var(--rf-text-dim);
    background-color: var(--rf-chip);
    margin-left: var(--rf-space-3);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    flex-shrink: 0;
}

.rf-player-row__meta {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

/* Skill name in regular weight; its level is set in bold by rich text inside the label. */
.rf-player-row .rf-player-row__skill {
    font-size: 17px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--rf-text);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-player-row .rf-player-row__percent {
    font-size: 17px;
    flex-shrink: 0;
    color: var(--rf-accent-bright);
    margin-left: var(--rf-space-3);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

/* Pushes the rate to the right edge of the text column so rates line up row to row. */
.rf-player-row__spacer {
    flex-grow: 1;
}

.rf-player-row .rf-player-row__rate {
    font-size: 16px;
    flex-shrink: 0;
    margin-left: var(--rf-space-3);
    color: var(--rf-success);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

/* ---- Level column ------------------------------------------------------------ */

/* One width on every row, so the bars and the rates end in one line down the list. A four digit
   level is set smaller (--long) to fit it; growing the column with the number squeezed the text
   column on those rows until the rate was cut off. */
.rf-player-row__level-col {
    width: 80px;
    flex-shrink: 0;
    align-items: flex-end;
    justify-content: center;
    margin-left: var(--rf-space-3);
}

.rf-player-row .rf-player-row__level-caption {
    font-size: 13px;
    color: var(--rf-text-dim);
    letter-spacing: 1px;
}

.rf-player-row .rf-player-row__level {
    font-size: 30px;
    color: var(--rf-accent);
    -unity-text-align: middle-right;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--rf-text-outline);
    text-shadow: 1px 2px 3px var(--rf-text-shadow-strong);
}

.rf-player-row .rf-player-row__level--long {
    font-size: 24px;
}

/* ---- Bars ------------------------------------------------------------------------- */

.rf-bar {
    height: 6px;
    background-color: var(--rf-bar-track);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.rf-bar--health {
    margin-top: 8px;
}

.rf-bar--exp {
    margin-top: 5px;
}

.rf-bar__fill {
    height: 100%;
    width: 0;
    /* Width is set from code. Transitioned so ticks glide instead of snapping. */
    transition-property: width, background-color;
    transition-duration: 0.3s, 0.2s;
    transition-timing-function: ease-out, ease-out;
}

.rf-bar--exp .rf-bar__fill {
    background-color: var(--rf-accent);
}

.rf-bar--health .rf-bar__fill {
    background-color: var(--rf-health);
}

/* Below a third, the bar brightens so a dying player stands out in a long list. */
.rf-bar--low .rf-bar__fill {
    background-color: var(--rf-health-low);
}

/* Starting position and size only. DraggableWindow overwrites both from saved preferences, and
   "reset positions" in the settings menu brings these back. */
#playerlist-window {
    left: 24px;
    top: 96px;
    width: 480px;
    height: 860px;
}

/* ==========================================================================
   Top centre status column
   ==========================================================================
   The XP boost pill, then any active event underneath. One flex column, so they stack instead of
   landing on top of each other. */

.rf-top-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/* ---- Keyboard shortcut menu (bottom right) ----------------------------------------
   Square icon tiles in groups, MMO micro menu style, thin accent lines between the groups. A tooltip
   with the name and the key as a key cap points down at the hovered tile. Sized as the first try
   looked at the smallest UI scale (0.6), which the user found right. The bar dims while the mouse
   is elsewhere. */

.rf-top-layer .rf-shortcuts {
    position: absolute;
    right: 16px;
    bottom: 14px;
    align-items: flex-end;
}

.rf-top-layer .rf-shortcuts__tip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgb(24, 22, 18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.rf-top-layer .rf-shortcuts__tip--visible {
    opacity: 1;
}

.rf-top-layer .rf-shortcuts__tip-name {
    margin-right: 8px;
    font-size: 14px;
    color: var(--rf-text);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
}

/* the key as a key cap */
.rf-top-layer .rf-shortcuts__tip-key {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 12px;
    color: var(--rf-text-dim);
    background-color: rgba(255, 244, 214, 0.05);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* a square turned on its corner, half under the bubble: the arrow pointing at the tile */
.rf-top-layer .rf-shortcuts__tip-arrow {
    position: absolute;
    bottom: -6px;
    width: 10px;
    height: 10px;
    rotate: 45deg;
    background-color: rgb(24, 22, 18);
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
}

.rf-top-layer .rf-shortcuts__row {
    flex-direction: row;
    align-items: center;
    opacity: 0.92;
    transition-property: opacity;
    transition-duration: 0.2s;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    /* solid: a little transparency shows the world plainly through */
    background-color: var(--rf-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-width: 2px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-top-layer .rf-shortcuts__row:hover {
    opacity: 1;
}

.rf-top-layer .rf-shortcuts__group {
    flex-direction: row;
}

/* 2px: a 1px line rounds away at the panel's scale */
.rf-top-layer .rf-shortcuts__divider {
    width: 2px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 6px;
    background-color: var(--rf-accent-dim);
}

.rf-top-layer .rf-shortcut {
    width: 40px;
    height: 40px;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 244, 214, 0.075);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.35);
    border-right-color: rgba(0, 0, 0, 0.35);
    border-top-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.rf-top-layer .rf-shortcut:hover {
    background-color: rgba(232, 163, 61, 0.16);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-top-layer .rf-shortcut:active {
    background-color: rgba(232, 163, 61, 0.3);
}

.rf-top-layer .rf-shortcut__icon {
    font-size: 18px;
    color: var(--rf-text);
}

.rf-top-layer .rf-shortcut:hover .rf-shortcut__icon {
    color: var(--rf-accent-bright);
}

.rf-top-column {
    position: absolute;
    top: 14px;
    align-items: center;
    transition-property: top;
    transition-duration: 0.25s;
}

/* ---- XP boost pill -------------------------------------------------------------- */

.rf-boost {
    flex-direction: row;
    align-items: center;
    height: 46px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    background-color: var(--rf-surface-glass);
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.rf-top-layer .rf-boost__icon {
    font-size: 20px;
    color: var(--rf-accent);
    margin-right: var(--rf-space-3);
}

.rf-top-layer .rf-boost__label {
    font-size: 19px;
    color: var(--rf-text);
    letter-spacing: 1px;
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-top-layer .rf-boost__sep {
    font-size: 19px;
    color: var(--rf-text-dim);
    margin-left: var(--rf-space-2);
    margin-right: var(--rf-space-2);
}

.rf-top-layer .rf-boost__time {
    font-size: 19px;
    color: var(--rf-accent-bright);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-boost__bar {
    width: 96px;
    height: 10px;
    margin-left: var(--rf-space-4);
    background-color: var(--rf-bar-track);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    overflow: hidden;
}

.rf-boost__fill {
    height: 100%;
    width: 100%;
    background-color: var(--rf-accent);
    transition-property: width;
    transition-duration: 0.5s;
}

/* The reason for the boost: a viewer to thank, or a message sent along with it. On its own chip
   rather than floating on the world: an outline on thin text read as hollow letters, while a dark
   backing gives plain text the contrast it needs over grass, snow or water alike. */
.rf-top-layer .rf-boost__thanks {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
    font-size: 16px;
    color: var(--rf-text);
    background-color: var(--rf-surface-glass);
    margin-top: 6px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 720px;
}

/* ---- Raid panel ---------------------------------------------------------------------
   Everything a raid has to say, in one panel under the boost pill: boss level, time left, health,
   raiders, and how to join. It replaces a full width card, a timer floating over the fight and a
   separate health bar, because viewers are here to watch the fight. */

.rf-raid {
    width: 780px;
    margin-top: var(--rf-space-3);
    padding-left: var(--rf-space-5);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-3);
    background-color: var(--rf-surface-glass);
    border-top-color: var(--rf-accent);
    border-top-width: 3px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out, ease-out;
}

/* Drops in from slightly above. Added on show, removed a frame later. */
.rf-raid--entering {
    opacity: 0;
    translate: 0 -16px;
}

/* The announcement: open for a few seconds when the boss appears, then folded away. Height and
   opacity both transition so it collapses smoothly rather than the panel jumping up. */
.rf-raid .rf-raid__announce {
    height: 0;
    opacity: 0;
    overflow: hidden;
    font-size: 30px;
    color: var(--rf-accent-bright);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--rf-text-outline);
    text-shadow: 2px 2px 4px var(--rf-text-shadow-strong);
    transition-property: height, opacity, margin-bottom;
    transition-duration: 0.35s, 0.3s, 0.35s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.rf-raid--announce .rf-raid__announce {
    height: 44px;
    opacity: 1;
    margin-bottom: var(--rf-space-1);
}

.rf-raid__top {
    flex-direction: row;
    align-items: center;
    height: 42px;
}

.rf-raid .rf-raid__title {
    font-size: 28px;
    color: var(--rf-text);
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--rf-text-outline);
    text-shadow: 1px 2px 2px var(--rf-text-shadow-strong);
}

.rf-raid .rf-raid__level {
    font-size: 24px;
    /* The "LV" prefix; RaidHudView colours the number itself gold through rich text. */
    color: var(--rf-text);
    margin-left: var(--rf-space-5);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-raid__spacer {
    flex-grow: 1;
}

/* Glacier blue: live and world state, as in the palette. */
.rf-live-dot {
    width: 12px;
    height: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--rf-live);
    margin-right: var(--rf-space-4);
}

.rf-top-layer .rf-raid__clock {
    font-size: 20px;
    color: var(--rf-text);
    margin-right: var(--rf-space-2);
}

.rf-raid .rf-raid__timer {
    font-size: 24px;
    color: var(--rf-text);
    min-width: 64px;
    -unity-text-align: middle-right;
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
    transition-property: color;
    transition-duration: 0.3s;
}

/* Under a minute left. */
.rf-raid .rf-raid__timer--low {
    color: var(--rf-health-low);
}

/* Two fills. The ghost trails the real health with a slower, delayed transition, so a heavy hit
   leaves a lighter band that drains a moment later, which is how players read "that one landed". */
.rf-raid__bar {
    height: 34px;
    margin-top: var(--rf-space-1);
    background-color: var(--rf-bar-track);
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    overflow: hidden;
}

.rf-raid__ghost,
.rf-raid__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.rf-raid__ghost {
    background-color: var(--rf-health-ghost);
    transition-property: width;
    transition-duration: 0.6s;
    transition-delay: 0.35s;
    transition-timing-function: ease-in-out;
}

/* A lighter top edge on the fill reads as a highlight, so the bar looks lit rather than flat. */
.rf-raid__fill {
    background-color: var(--rf-health);
    border-top-width: 2px;
    border-top-color: var(--rf-health-shine);
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.rf-raid .rf-raid__hp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 20px;
    color: var(--rf-text);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--rf-text-outline);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

/* Bottom line: raiders left, health percentage centred, join instruction right. The two sides share
   the spare width equally so the percentage stays centred whether or not the join pill shows. */
.rf-raid__bottom {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-top: var(--rf-space-2);
}

.rf-raid__side {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.rf-raid__side--end {
    justify-content: flex-end;
}

.rf-top-layer .rf-raid__people {
    font-size: 22px;
    color: var(--rf-live);
    margin-right: var(--rf-space-3);
}

.rf-raid .rf-raid__raiders {
    font-size: 21px;
    color: var(--rf-text);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-raid .rf-raid__percent {
    font-size: 32px;
    color: var(--rf-accent);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--rf-text-outline);
    text-shadow: 1px 2px 3px var(--rf-text-shadow-strong);
}

.rf-raid__join-pill {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-top-layer .rf-raid__chat {
    font-size: 18px;
    color: var(--rf-text);
    margin-right: var(--rf-space-3);
}

.rf-raid .rf-raid__join {
    font-size: 19px;
    color: var(--rf-text);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

/* ---- Dungeon panel ------------------------------------------------------------------
   The raid panel's layout with a purple edge and dot, so a viewer can tell at a glance which
   kind of event is running. The health bar only appears in the boss room; before that the bar
   would have nothing to say. */

.rf-raid--dungeon {
    border-top-color: var(--rf-dungeon);
}

.rf-raid--dungeon .rf-live-dot {
    background-color: var(--rf-dungeon);
}

.rf-raid--dungeon .rf-raid__percent {
    color: var(--rf-dungeon-bright);
}

.rf-raid--no-bar .rf-raid__bar {
    display: none;
}

.rf-dungeon__enemies {
    flex-direction: row;
    align-items: center;
}

.rf-top-layer .rf-dungeon__skull {
    font-size: 20px;
    color: var(--rf-health-low);
    margin-right: var(--rf-space-2);
}

/* ---- Town resource bar --------------------------------------------------------------
   Village level, the five resources with their hourly rates, and houses. Shown in free camera
   mode, first in the top column, so the boost pill and any event stack beneath it. */

.rf-town {
    flex-direction: row;
    align-items: center;
    height: 80px;
    margin-bottom: var(--rf-space-3);
    padding-left: var(--rf-space-2);
    padding-right: var(--rf-space-2);
    background-color: var(--rf-surface-glass);
    border-top-color: var(--rf-accent);
    border-top-width: 3px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-town__resources {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

.rf-town__section {
    flex-direction: row;
    align-items: center;
    height: 100%;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    border-right-width: 1px;
    border-right-color: var(--rf-divider);
}

.rf-town__section--houses {
    border-right-width: 0;
}

.rf-town__res-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: var(--rf-space-3);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-top-layer .rf-town__home,
.rf-top-layer .rf-town__houses-icon {
    width: 40px;
    font-size: 28px;
    color: var(--rf-accent);
    margin-right: var(--rf-space-3);
}

.rf-town__text {
    min-width: 92px;
}

.rf-top-layer .rf-town__caption {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
    font-size: 13px;
    color: var(--rf-text-dim);
    letter-spacing: 1px;
}

.rf-top-layer .rf-town__value {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
    -unity-font-style: normal;
    font-size: 22px;
    color: var(--rf-text);
    text-shadow: 1px 1px 2px var(--rf-text-shadow-strong);
}

.rf-top-layer .rf-town__rate {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
    font-size: 13px;
    color: var(--rf-success);
}

.rf-top-layer .rf-town__rate--down {
    color: rgb(255, 110, 100);
}

.rf-town__exp {
    height: 4px;
    margin-top: 4px;
    background-color: var(--rf-bar-track);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    overflow: hidden;
}

.rf-town__exp-fill {
    height: 100%;
    width: 0;
    background-color: var(--rf-accent);
    transition-property: width;
    transition-duration: 0.4s;
}

/* The build mode button at the end of the town bar, gold like the mockup. */
.rf-top-layer .rf-town__build {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-left: var(--rf-space-2);
    margin-right: var(--rf-space-1);
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: 0;
    padding-bottom: 0;
    background-color: var(--rf-accent);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-top-layer .rf-town__build:hover {
    background-color: var(--rf-accent-bright);
}

/* While build mode is on the button turns dark with a gold edge and reads "exit". */
.rf-top-layer .rf-town__build--active {
    background-color: var(--rf-surface-raised);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-top-layer .rf-town__build--active:hover {
    background-color: var(--rf-accent-wash);
}

/* A town hall upgrade can be bought: a small green arrow on the corner of the build button. */
.rf-top-layer .rf-town__build-badge {
    position: absolute;
    top: -7px;
    right: -7px;
    width: 20px;
    height: 20px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--rf-text);
    background-color: var(--rf-success);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.rf-top-layer .rf-town__build-icon {
    font-size: 22px;
    color: var(--rf-text-on-accent);
    margin-right: var(--rf-space-2);
}

.rf-top-layer .rf-town__build-label {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
    -unity-font-style: normal;
    font-size: 16px;
    color: var(--rf-text-on-accent);
}

.rf-top-layer .rf-town__build--active .rf-town__build-icon,
.rf-top-layer .rf-town__build--active .rf-town__build-label {
    color: var(--rf-accent);
}

/* Folds the bar away into the tab below: a small square at the right end of the bar. */
.rf-top-layer .rf-town__fold {
    width: 32px;
    height: 32px;
    margin-left: 0;
    margin-right: var(--rf-space-1);
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-top-layer .rf-town__fold:hover {
    background-color: var(--rf-surface-raised);
}

.rf-top-layer .rf-town__fold-icon {
    flex-grow: 1;
    font-size: 14px;
    -unity-text-align: middle-center;
    color: var(--rf-text-dim);
}

.rf-top-layer .rf-town__fold:hover .rf-town__fold-icon {
    color: var(--rf-text);
}

/* ---- Town bar, folded ------------------------------------------------------------
   What is left of the bar when it is folded: a small "VILLAGE" tab with a chevron, in the bar's
   colours, that brings the bar back when clicked. */

.rf-top-layer .rf-town-tab {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: var(--rf-space-3);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-top: 0;
    padding-bottom: 0;
    background-color: var(--rf-surface-glass);
    border-top-color: var(--rf-accent);
    border-top-width: 3px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-top-layer .rf-town-tab:hover {
    background-color: var(--rf-surface-raised);
}

.rf-top-layer .rf-town-tab__icon {
    font-size: 14px;
    color: var(--rf-accent);
    margin-right: var(--rf-space-2);
}

.rf-top-layer .rf-town-tab__label {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
    font-size: 13px;
    color: var(--rf-text-dim);
    letter-spacing: 1px;
}

.rf-top-layer .rf-town-tab__chevron {
    font-size: 11px;
    color: var(--rf-text-dim);
    margin-left: var(--rf-space-2);
}

.rf-top-layer .rf-town-tab:hover .rf-town-tab__label,
.rf-top-layer .rf-town-tab:hover .rf-town-tab__chevron {
    color: var(--rf-text);
}


/* ---- Stream quest ----------------------------------------------------------------
   StreamQuestView: the bar under the village bar while a stream quest runs (a small pill when none does), last in
   the top column so the raid and dungeon bars keep their place, and the quest window it opens (also opened by
   clicking a quest board in the world), which sits in the connection document. Both documents load this sheet.
   Gold like the restore window: a choice for the streamer, not a warning. */

.rf-squest-bar {
    flex-direction: row;
    align-items: center;
    min-width: 560px;
    max-width: 820px;
    margin-top: var(--rf-space-2);
    padding-left: 10px;
    padding-right: var(--rf-space-5);
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(20, 18, 15, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-squest-bar:hover {
    background-color: var(--rf-surface-raised);
}

.rf-squest-bar--idle {
    min-width: 0;
    height: 44px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 6px;
    padding-right: var(--rf-space-4);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    opacity: 0.85;
}

.rf-squest-bar .rf-squest-bar__icon {
    width: 32px;
    height: 32px;
    margin-right: var(--rf-space-3);
    font-size: 15px;
    -unity-text-align: middle-center;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.rf-squest-bar__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest-bar .rf-squest-bar__text {
    font-size: 19px;
    color: var(--rf-text);
    -unity-font-style: bold;
}

.rf-squest-bar .rf-squest-bar__meta {
    font-size: 15px;
    color: var(--rf-text-dim);
}

.rf-squest-track {
    height: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: var(--rf-bar-track);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.rf-squest-track--large {
    height: 10px;
    margin-top: var(--rf-space-2);
    margin-bottom: var(--rf-space-1);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.rf-squest-track__fill {
    height: 100%;
    width: 0;
    background-color: var(--rf-accent);
}

.rf-squest {
    position: absolute;
    left: 50%;
    top: 14%;
    width: 760px;
    margin-left: -380px;
    padding-left: var(--rf-space-5);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-4);
    padding-bottom: var(--rf-space-4);
    background-color: var(--rf-surface-glass);
    border-top-color: var(--rf-accent);
    border-top-width: 3px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-squest__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rf-space-2);
}

.rf-squest .rf-squest__title {
    flex-grow: 1;
    font-size: 26px;
    color: var(--rf-text);
    -unity-font-style: bold;
}

.rf-squest .rf-squest__close {
    width: 36px;
    height: 36px;
    margin-left: 0;
    margin-right: 0;
    font-size: 18px;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-squest .rf-squest__close:hover {
    color: var(--rf-text);
    background-color: var(--rf-row-hover);
}

.rf-squest .rf-squest__section {
    margin-bottom: var(--rf-space-3);
    font-size: 18px;
    white-space: normal;
    color: var(--rf-text-dim);
}

.rf-squest .rf-squest__empty {
    white-space: normal;
    margin-bottom: var(--rf-space-3);
    font-size: 18px;
    color: var(--rf-text-dim);
}

.rf-squest .rf-squest__error {
    font-size: 17px;
    color: var(--rf-danger);
    white-space: normal;
}

.rf-squest .rf-squest__hint {
    margin-top: var(--rf-space-2);
    font-size: 16px;
    color: var(--rf-text-faint);
    white-space: normal;
}

.rf-squest-card {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
    background-color: var(--rf-row-alt);
    border-left-width: 3px;
    border-left-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-squest-card:hover {
    background-color: var(--rf-row-hover);
}

.rf-squest-card--active {
    border-left-color: var(--rf-accent);
    background-color: var(--rf-accent-wash);
}

.rf-squest-card__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--rf-space-3);
}

.rf-squest-card .rf-squest-card__title {
    font-size: 21px;
    color: var(--rf-text);
    -unity-font-style: bold;
    white-space: normal;
}

.rf-squest-card .rf-squest-card__meta {
    font-size: 16px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest-card .rf-squest-card__reward {
    font-size: 16px;
    color: var(--rf-accent-bright);
    white-space: normal;
}

.rf-squest-card .rf-squest-card__helpers {
    margin-top: var(--rf-space-1);
    font-size: 16px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest-card .rf-squest-card__button {
    min-width: 110px;
    margin-left: 0;
    margin-right: 0;
}

/* ---- The quest window's tabs and the streamer's quest form -------------------------------------------
   StreamQuestView's tabs (the stream quest, the streamer's own quests) and StreamerQuestPanel's form, drawn here as
   the shop window draws its chips and fields, so nothing depends on Unity's runtime dropdowns. */

.rf-squest .rf-squest__scroll {
    max-height: 880px;
    flex-shrink: 1;
}

.rf-squest-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: var(--rf-space-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--rf-divider);
}

.rf-squest .rf-squest-tab {
    height: 44px;
    margin-left: 0;
    margin-right: var(--rf-space-2);
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.rf-squest .rf-squest-tab:hover {
    color: var(--rf-text);
    background-color: var(--rf-row-hover);
}

.rf-squest .rf-squest-tab--active {
    color: var(--rf-text);
    border-bottom-color: var(--rf-accent);
}

.rf-squest .rf-squest-form__label {
    margin-top: var(--rf-space-3);
    margin-bottom: var(--rf-space-1);
    font-size: 16px;
    color: var(--rf-text);
    -unity-font-style: bold;
    white-space: normal;
}

.rf-squest .rf-squest-form__note {
    margin-top: var(--rf-space-1);
    margin-bottom: var(--rf-space-1);
    font-size: 14px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest .rf-squest-form__summary {
    margin-top: var(--rf-space-4);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    font-size: 16px;
    color: var(--rf-accent-bright);
    background-color: var(--rf-accent-wash);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    white-space: normal;
}

.rf-squest-form__buttons {
    flex-direction: row;
    align-items: center;
    margin-top: var(--rf-space-3);
}

.rf-squest .rf-squest-form__post {
    align-self: flex-start;
    margin-left: 0;
    margin-top: var(--rf-space-2);
}

.rf-squest .rf-squest-chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.rf-squest .rf-squest-chip {
    height: 32px;
    margin-left: 0;
    margin-right: var(--rf-space-2);
    margin-top: 0;
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    font-size: 14px;
    color: var(--rf-text-dim);
    background-color: var(--rf-surface-raised);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.rf-squest .rf-squest-chip:hover {
    color: var(--rf-text);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-squest .rf-squest-chip--active {
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
}

.rf-squest .rf-squest-chip--active:hover {
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent-bright);
}

.rf-squest .rf-squest-field {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: var(--rf-space-2);
}

.rf-squest .rf-squest-field > .unity-text-field__input,
.rf-squest .rf-squest-field .unity-base-text-field__input {
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
    font-size: 15px;
    color: var(--rf-text);
    background-color: var(--rf-bar-track);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-squest .rf-squest-field--tall > .unity-text-field__input,
.rf-squest .rf-squest-field--tall .unity-base-text-field__input {
    height: 64px;
    padding-top: 6px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.rf-squest .rf-squest-field:focus > .unity-text-field__input,
.rf-squest .rf-squest-field:focus .unity-base-text-field__input {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-squest .rf-squest-items {
    max-height: 190px;
    margin-bottom: var(--rf-space-2);
    background-color: var(--rf-bar-track);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-squest .rf-squest-item {
    height: 30px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--rf-space-3);
    -unity-text-align: middle-left;
    font-size: 14px;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.rf-squest .rf-squest-item:hover {
    color: var(--rf-text);
    background-color: var(--rf-row-hover);
}

.rf-squest .rf-squest-item--selected {
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
}

/* ---- The Village tab: the streamer's story lines (StoryPanel) ---------------------------------------
   Each story is told as a talk with its NPC: a speech box with the NPC's name and words, then what the stream must
   do, and the streamer's buttons (talk, the choice, let chat vote). */

.rf-squest .rf-story__speech {
    margin-top: var(--rf-space-2);
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    background-color: rgba(0, 0, 0, 0.35);
    border-left-width: 3px;
    border-left-color: var(--rf-accent-dim);
    border-top-right-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-squest .rf-story__npc {
    font-size: 15px;
    color: var(--rf-accent-bright);
    -unity-font-style: bold;
}

.rf-squest .rf-story__line {
    margin-top: var(--rf-space-1);
    font-size: 17px;
    color: var(--rf-text);
    -unity-font-style: italic;
    white-space: normal;
}

.rf-squest .rf-story__actions {
    margin-top: var(--rf-space-2);
    align-items: center;
}

.rf-squest .rf-story__abandon {
    margin-left: var(--rf-space-4);
    opacity: 0.7;
}

/* ---- Hero mode ----------------------------------------------------------------------------------------
   HeroHudView (docs/hero-mode-design.md): a health orb bottom left, a mana orb bottom right, the skill bar between
   them. The orbs fill from the bottom; a skill's cooldown sweeps down over it. While the hero plays, the documents
   get rf-hero-mode and the usual HUD steps aside (visibility, as their views set their own display). */

.rf-hero-mode .rf-town,
.rf-hero-mode .rf-town-tab,
.rf-hero-mode .rf-shortcuts,
.rf-hero-mode #squest-bar {
    visibility: hidden;
}

.rf-hero {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* the orbs (after the user's reference): a 150 px glass sphere (the Hero Orb shader's render texture, see-through
   where it is empty), the number in the middle, the label under it */
/* The orbs flank the skill bar (the user, 2026-11-03: at the screen's edges both could not be watched at once):
   from the middle, half the bar (6 slots of 72px, the 18px gap, padding and border: 476px) and 14px either side. */
.rf-hero-orb {
    position: absolute;
    bottom: 38px;
    width: 150px;
    height: 150px;
    left: 50%;
}

.rf-hero-orb--health {
    margin-left: -402px;
}

.rf-hero-orb--mana {
    margin-left: 252px;
}

/* The plate behind the skill bar and under both orbs, so the three read as one piece (the user's mockup): from the
   middle out to the orbs' centres (half the bar 238px, the 14px gap, half an orb 75px). */
.rf-hero-dock {
    position: absolute;
    left: 50%;
    width: 654px;
    margin-left: -327px;
    bottom: 26px;
    height: 102px;
    background-color: rgba(20, 18, 15, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* The gold socket ring round each orb (HeroUI/orb-health and orb-mana, the gem on top, a bracket below): its opening
   is 65% of the picture, centred, so 226px round a 150px orb covers the sphere's edge by a hair. */
.rf-hero-orb__socket {
    position: absolute;
    left: -38px;
    top: -38px;
    width: 226px;
    height: 226px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-hero-orb__sphere {
    position: absolute;
    left: 0;
    top: 0;
    width: 150px;
    height: 150px;
}

.rf-hero-orb__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(255, 246, 236);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

/* The orbs in their gilded sockets need no words under them: the numbers are in the orbs. */
.rf-hero-orb__label {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 154px;
    -unity-text-align: middle-center;
    font-size: 15px;
    color: rgb(250, 240, 222);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.85);
}



.rf-hero-bar {
    position: absolute;
    bottom: 32px;
    left: 0;
    right: 0;
    align-items: center;
}

/* the style over the skill bar: icon, name and level, and Tab to switch */
.rf-hero-style {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: rgba(20, 18, 15, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.rf-hero-style__icon {
    font-size: 15px;
    color: var(--rf-accent-bright);
    margin-right: 6px;
}

.rf-hero-style--ranged .rf-hero-style__icon {
    color: rgb(150, 210, 110);
}

.rf-hero-style--magic .rf-hero-style__icon {
    color: rgb(120, 170, 255);
}

.rf-hero-style--healing .rf-hero-style__icon {
    color: rgb(255, 226, 120);
}

.rf-hero-style__name {
    font-size: 14px;
    color: var(--rf-text);
    -unity-font-style: bold;
    margin-right: 8px;
}

.rf-hero-style__key {
    font-size: 11px;
    color: var(--rf-text-dim);
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-hero-style--flash {
    border-left-color: var(--rf-danger);
    border-right-color: var(--rf-danger);
    border-top-color: var(--rf-danger);
    border-bottom-color: var(--rf-danger);
}

.rf-hero-bar__row {
    flex-direction: row;
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-hero-slot {
    width: 64px;
    height: 64px;
    margin-left: 4px;
    margin-right: 4px;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    background-color: var(--rf-surface-raised);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

/* the round minimap, top right (HeroMinimap) */
.rf-hero-minimap {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 196px;
    height: 196px;
}

.rf-hero-minimap__map {
    position: absolute;
    left: 14px;
    top: 14px;
    right: 14px;
    bottom: 14px;
    overflow: hidden;
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-left-radius: 84px;
    border-bottom-right-radius: 84px;
    background-color: rgb(30, 92, 122);
    -unity-background-scale-mode: scale-and-crop;
}

.rf-hero-minimap__dots {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rf-hero-minimap__dot {
    position: absolute;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.8);
    border-right-color: rgba(0, 0, 0, 0.8);
    border-top-color: rgba(0, 0, 0, 0.8);
    border-bottom-color: rgba(0, 0, 0, 0.8);
}

.rf-hero-minimap__dot--friend {
    background-color: rgb(90, 220, 90);
}

.rf-hero-minimap__dot--enemy {
    background-color: rgb(235, 60, 50);
}

/* a quest or someone to talk to: bigger, gold, like the marks over their heads */
.rf-hero-minimap__dot--quest {
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    margin-top: -5.5px;
    background-color: rgb(255, 196, 64);
}

.rf-hero-minimap__hero {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(255, 236, 170);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

.rf-hero-minimap__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* The big map (HeroBigMap, M): the island from above over the middle of the screen, the hero and the people on it, a
   pin where a click sent the hero. */
.rf-hero-bigmap {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.rf-hero-bigmap__panel {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgb(20, 18, 15);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.rf-hero-bigmap__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.rf-hero-bigmap .rf-hero-bigmap__icon {
    font-size: 24px;
    color: rgb(236, 190, 52);
    margin-right: 10px;
}

.rf-hero-bigmap .rf-hero-bigmap__title {
    flex-grow: 1;
    font-size: 26px;
    color: rgb(245, 236, 214);
}

.rf-hero-bigmap .rf-hero-bigmap__close {
    width: 36px;
    height: 36px;
    margin-left: 6px;
    font-size: 18px;
    color: rgb(200, 190, 170);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-hero-bigmap .rf-hero-bigmap__close:hover {
    color: rgb(255, 214, 90);
}

.rf-hero-bigmap__map {
    width: 680px;
    height: 680px;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.5);
    border-right-color: rgba(214, 170, 40, 0.5);
    border-top-color: rgba(214, 170, 40, 0.5);
    border-bottom-color: rgba(214, 170, 40, 0.5);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-hero-bigmap__dots {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rf-hero-bigmap__dot {
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
}

.rf-hero-bigmap .rf-hero-bigmap__hero {
    position: absolute;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(255, 214, 90);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(20, 18, 15);
}

/* Where a click on either map sent the hero: a gold ring with a dark middle. */
.rf-hero-bigmap__pin {
    position: absolute;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
    background-color: rgba(20, 18, 15, 0.8);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 214, 90);
    border-right-color: rgb(255, 214, 90);
    border-top-color: rgb(255, 214, 90);
    border-bottom-color: rgb(255, 214, 90);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.rf-hero-bigmap .rf-hero-bigmap__hint {
    margin-top: 8px;
    font-size: 15px;
    color: rgb(225, 214, 190);
    -unity-text-align: middle-center;
}

.rf-hero-slot--gap {
    margin-left: 18px;
}

.rf-hero-slot__icon {
    font-size: 26px;
    color: var(--rf-accent-bright);
}

/* the painted icon, filling the slot under the sweep and the labels */
.rf-hero-slot__picture {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.rf-hero-slot--low .rf-hero-slot__picture {
    -unity-background-image-tint-color: rgb(120, 140, 230);
}

.rf-hero-slot__sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.62);
}

/* the key and the note (mana, cooldown, potions) on solid badges, readable over any picture (playtest 18) */
.rf-hero-slot__key {
    position: absolute;
    left: 2px;
    top: 2px;
    min-width: 18px;
    padding: 1px 4px;
    font-size: 13px;
    color: var(--rf-text);
    -unity-text-align: middle-center;
    background-color: var(--rf-bg);
    border-radius: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-hero-slot__note {
    position: absolute;
    right: 2px;
    bottom: 2px;
    padding: 1px 4px;
    font-size: 13px;
    color: var(--rf-text);
    background-color: var(--rf-bg);
    border-radius: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-hero-slot:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

/* the skill bar's tooltip, over the slot under the mouse */
.rf-hero-tip {
    position: absolute;
    padding: 10px 14px 12px 14px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-color: var(--rf-accent-dim);
    border-radius: 8px;
}

.rf-hero-tip__title {
    font-size: 19px;
    color: var(--rf-accent-bright);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-hero-tip__body {
    margin-top: 4px;
    font-size: 15px;
    color: var(--rf-text);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-hero-tip__meta {
    margin-top: 8px;
    font-size: 14px;
    color: var(--rf-text-dim);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-hero-slot--locked {
    opacity: 0.45;
}

.rf-hero-slot--low .rf-hero-slot__icon {
    color: rgb(90, 120, 210);
}

.rf-hero-slot--flash {
    border-left-color: var(--rf-danger);
    border-right-color: var(--rf-danger);
    border-top-color: var(--rf-danger);
    border-bottom-color: var(--rf-danger);
}

/* the left column: the bounties under way, then the party, stacked so they never overlap */
.rf-hero-left {
    position: absolute;
    left: 16px;
    top: 22%;
    align-items: flex-start;
}

/* the party on the left: who is on Ravebridge besides the hero, with their health */
.rf-hero-party {
    width: 240px;
    padding: 8px 12px 10px 12px;
    background-color: rgba(14, 12, 10, 0.82);
    border-left-width: 3px;
    border-left-color: var(--rf-accent);
    border-top-right-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-hero-party__title {
    font-size: 15px;
    color: var(--rf-accent-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.rf-hero-party__row {
    margin-bottom: 6px;
}

.rf-hero-party__name {
    font-size: 15px;
    color: var(--rf-text);
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.rf-hero-party__bar {
    height: 7px;
    margin-top: 3px;
    background-color: rgba(0, 0, 0, 0.7);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    overflow: hidden;
}

.rf-hero-party__head {
    flex-direction: row;
    align-items: center;
}

.rf-hero-party__style {
    font-size: 14px;
    width: 20px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    color: var(--rf-accent-bright);
}

.rf-hero-party__style--ranged {
    color: rgb(130, 210, 110);
}

.rf-hero-party__style--magic {
    color: rgb(150, 160, 255);
}

.rf-hero-party__style--healing {
    color: rgb(255, 225, 120);
}

/* health: green, yellow under half, red under a quarter, grey when down */
.rf-hero-party__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(74, 186, 84);
}

.rf-hero-party__row--hurt .rf-hero-party__fill {
    background-color: rgb(214, 170, 40);
}

.rf-hero-party__row--low .rf-hero-party__fill {
    background-color: rgb(196, 48, 48);
}

.rf-hero-party__row--down {
    opacity: 0.45;
}

.rf-hero-party__row--down .rf-hero-party__fill {
    background-color: rgb(90, 90, 90);
}

/* hero mode's inventory (I): the quest window's look, on the right; worn gear, then the backpack */
.rf-hero-inv {
    left: auto;
    right: 24px;
    top: 10%;
    width: 470px;
    margin-left: 0;
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
}

.rf-hero-inv__section {
    margin-top: var(--rf-space-2);
    margin-bottom: var(--rf-space-1);
    font-size: 14px;
    color: var(--rf-accent-bright);
    -unity-font-style: bold;
}

.rf-hero-inv__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.rf-hero-inv__scroll {
    max-height: 330px;
}

.rf-hero-inv__tile {
    width: 56px;
    height: 56px;
    margin-right: 6px;
    margin-bottom: 6px;
    justify-content: center;
    align-items: center;
    background-color: var(--rf-surface-raised);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

.rf-hero-inv__tile:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    background-color: var(--rf-row-hover);
}

.rf-hero-inv__tile--worn {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-hero-inv__tile--empty {
    opacity: 0.4;
}

.rf-hero-inv__tile--blocked .rf-hero-inv__icon {
    -unity-background-image-tint-color: rgb(255, 120, 110);
    opacity: 0.6;
}

.rf-hero-inv__tile--other {
    background-color: rgba(255, 255, 255, 0.03);
}

.rf-hero-inv__icon {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 5px;
    bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-hero-inv__initials {
    font-size: 15px;
    color: var(--rf-text-dim);
    -unity-font-style: bold;
}

/* the Ravebridge bag (RavebridgeLoot): its coins beside the title, loot tiles framed in their rarity's colour */
.rf-hero-inv__island-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.rf-hero-inv__coins {
    margin-bottom: var(--rf-space-1);
    font-size: 13px;
    color: rgb(255, 209, 77);
    -unity-font-style: bold;
}

.rf-hero-inv__tile--island {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.rf-hero-inv__totals {
    margin-bottom: var(--rf-space-1);
    font-size: 12px;
    color: rgb(140, 200, 255);
    white-space: normal;
}

.rf-hero-inv__glyph {
    font-size: 26px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

/* the shopkeeper's cart (RavebridgeShopWindow) */
.rf-shop {
    width: 560px;
    margin-left: -280px;
    top: 12%;
}

.rf-shop__bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--rf-space-2);
}

.rf-shop__coins {
    margin-bottom: var(--rf-space-2);
    font-size: 15px;
    color: rgb(255, 209, 77);
    -unity-font-style: bold;
}

.rf-shop__scroll {
    max-height: 430px;
}

.rf-shop__row {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.rf-shop__row .rf-hero-inv__tile {
    flex-shrink: 0;
    margin-bottom: 0;
    margin-right: var(--rf-space-3);
}

.rf-shop__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-shop__name {
    font-size: 15px;
    color: var(--rf-text);
    -unity-font-style: bold;
}

.rf-shop__detail {
    font-size: 13px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest .rf-squest-chip.rf-shop__price {
    flex-shrink: 0;
    margin-left: var(--rf-space-2);
    margin-right: 0;
    margin-bottom: 0;
    min-width: 92px;
}

/* the bounties under way (HeroHudView): left, where the players list stood */
.rf-hero-bounties {
    width: 240px;
    padding: 8px 12px 10px 12px;
    background-color: rgba(14, 12, 10, 0.82);
    border-left-width: 3px;
    border-left-color: var(--rf-accent);
    border-top-right-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
    margin-bottom: 8px;
}

.rf-hero-bounties__title {
    font-size: 15px;
    color: var(--rf-accent-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.rf-hero-bounties__quest {
    font-size: 15px;
    color: var(--rf-text);
    -unity-font-style: bold;
    margin-top: 4px;
    white-space: normal;
}

.rf-hero-bounties__row {
    font-size: 14px;
    color: rgb(214, 204, 188);
    margin-left: 10px;
}

.rf-hero-bounties__row--done {
    color: rgb(110, 220, 110);
}

/* the shopkeeper's buffs over the skill bar (HeroHudView) */
.rf-hero-buffs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 4px;
}

.rf-hero-buff {
    flex-direction: row;
    align-items: center;
    margin-left: 3px;
    margin-right: 3px;
    padding: 2px 8px 2px 6px;
    background-color: rgba(10, 8, 6, 0.7);
    border-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(77, 153, 255, 0.6);
    border-right-color: rgba(77, 153, 255, 0.6);
    border-top-color: rgba(77, 153, 255, 0.6);
    border-bottom-color: rgba(77, 153, 255, 0.6);
}

.rf-hero-buff__icon {
    font-size: 14px;
    color: rgb(120, 180, 255);
    margin-right: 5px;
}

.rf-hero-buff__time {
    font-size: 13px;
    color: var(--rf-text);
}

/* loot on the ground and what was picked up (LootLabels) */
.rf-loot-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rf-loot-label {
    position: absolute;
    left: 0;
    top: 0;
    padding: 2px 7px 3px 7px;
    font-size: 17px;
    background-color: rgba(10, 8, 6, 0.78);
    border-radius: 3px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    white-space: nowrap;
}

.rf-loot-label--rare {
    font-size: 18px;
    -unity-font-style: bold;
}

.rf-loot-popup {
    background-color: rgba(0, 0, 0, 0);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.rf-hero-inv__amount {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 11px;
    color: var(--rf-text);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.rf-hero-inv__empty {
    font-size: 14px;
    color: var(--rf-text-faint);
}

/* a wave run (HeroWaveHud), redesigned 2026-11-02: one solid column at the top centre (under the Ravebridge pill):
   the wave plate and track, then the boss, chat's boon vote, the leave warning, the downed panel; the result card
   after the run; banners for the moments lower down, clear of the hero */
.rf-wave {
    position: absolute;
    top: 100px;
    left: 0;
    right: 0;
    align-items: center;
}

.rf-wave .rf-wave--b,
.rf-wave__badge-of,
.rf-wave__count-cap,
.rf-wave__from-text,
.rf-wave-track__clock-text,
.rf-wave-boons__hint,
.rf-wave-boons__effect,
.rf-wave-leave__sub,
.rf-wave-down__cap,
.rf-wave-down__label,
.rf-wave-down__healer-text,
.rf-wave-result__best-sub,
.rf-wave-result__chip-text,
.rf-wave-banner__sub {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
}

.rf-wave__badge-cap,
.rf-wave__badge-num,
.rf-wave__title,
.rf-wave__count-num,
.rf-wave-track__info-text,
.rf-wave-boss__name,
.rf-wave-boss__tag-text,
.rf-wave-boss__pct,
.rf-wave-boons__title,
.rf-wave-boons__cmd,
.rf-wave-boons__name,
.rf-wave-boons__votes,
.rf-wave-leave__key,
.rf-wave-leave__main,
.rf-wave-down__title,
.rf-wave-down__num,
.rf-wave-down__cmd,
.rf-wave-down__votes,
.rf-wave-down__healer-pct,
.rf-wave-result__title,
.rf-wave-result__stat-num,
.rf-wave-result__stat-cap,
.rf-wave-result__best-main,
.rf-wave-result__chest-name,
.rf-wave-result__chest-what,
.rf-wave-banner__cap,
.rf-wave-banner__text {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
    -unity-font-style: normal;
}

.rf-wave__spacer {
    flex-grow: 1;
}

/* ---- the wave plate ---- */
.rf-wave__plate {
    flex-direction: row;
    width: 720px;
    height: 104px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-bottom-width: 0;
    border-color: var(--rf-border-strong);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    overflow: hidden;
}

.rf-wave__badge {
    width: 108px;
    align-items: center;
    justify-content: center;
    background-color: var(--rf-accent);
}

.rf-wave__badge-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--rf-text);
    opacity: 0;
}

.rf-wave__badge-cap {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--rf-text-on-accent);
    -unity-text-align: middle-center;
}

.rf-wave__badge-num {
    font-size: 50px;
    color: var(--rf-text-on-accent);
    -unity-text-align: middle-center;
    margin-top: -4px;
    margin-bottom: -4px;
}

.rf-wave__badge-of {
    font-size: 15px;
    color: var(--rf-text-on-accent);
}

.rf-wave__badge--ready {
    background-color: var(--rf-surface-raised);
}

.rf-wave__badge--ready .rf-wave__badge-cap {
    color: var(--rf-accent);
}

.rf-wave__badge--ready .rf-wave__badge-num,
.rf-wave__badge--ready .rf-wave__badge-of,
.rf-wave__badge--boss .rf-wave__badge-cap,
.rf-wave__badge--boss .rf-wave__badge-num,
.rf-wave__badge--boss .rf-wave__badge-of {
    color: var(--rf-text);
}

.rf-wave__badge--boss {
    background-color: var(--rf-boss);
}

.rf-wave__badge--held {
    background-color: var(--rf-success);
}

.rf-wave__body {
    flex-grow: 1;
    justify-content: space-between;
    padding: 12px 18px;
}

.rf-wave__head {
    flex-direction: row;
    align-items: flex-end;
}

.rf-wave__title-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.rf-wave__title-icon {
    font-size: 22px;
    margin-right: 10px;
    color: var(--rf-success-bright);
}

.rf-wave__title {
    font-size: 26px;
    color: var(--rf-text);
}

.rf-wave__title--last {
    color: var(--rf-accent-bright);
}

.rf-wave__title--held {
    color: var(--rf-success-bright);
}

.rf-wave__count {
    flex-direction: row;
    align-items: flex-end;
}

.rf-wave__count-icon {
    font-size: 18px;
    color: var(--rf-text-dim);
    margin-right: 8px;
    margin-bottom: 5px;
}

.rf-wave__count-num {
    font-size: 28px;
    color: var(--rf-text);
}

.rf-wave__count-num--hot {
    color: var(--rf-danger-text);
}

.rf-wave__count-cap {
    font-size: 16px;
    color: var(--rf-text-dim);
    margin: 0 8px 5px 8px;
}

.rf-wave__bar {
    height: 16px;
    background-color: rgb(52, 47, 40);
    border-radius: 8px;
    overflow: hidden;
}

.rf-wave__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--rf-accent);
    border-radius: 8px;
}

.rf-wave__fill--time {
    background-color: var(--rf-text);
}

.rf-wave__fill--late {
    background-color: var(--rf-danger);
}

.rf-wave__from {
    flex-direction: row;
    align-items: center;
}

.rf-wave__from-icon {
    font-size: 16px;
    color: var(--rf-accent);
    margin-right: 8px;
}

.rf-wave__from-text {
    font-size: 17px;
    color: var(--rf-text-dim);
}

.rf-wave__from--boss .rf-wave__from-icon {
    color: var(--rf-danger);
}

.rf-wave__from--boss .rf-wave__from-text {
    color: var(--rf-danger-text);
}

/* ---- the wave track ---- */
.rf-wave-track {
    flex-direction: row;
    align-items: center;
    width: 720px;
    height: 46px;
    padding: 0 16px;
    background-color: var(--rf-surface);
    border-width: 2px;
    border-color: var(--rf-border-strong);
    border-top-color: var(--rf-border);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-wave-track__clock {
    width: 96px;
    flex-direction: row;
    align-items: center;
}

.rf-wave-track__clock-icon {
    font-size: 15px;
    color: var(--rf-text-dim);
    margin-right: 8px;
}

.rf-wave-track__clock-text {
    font-size: 17px;
    color: var(--rf-text-dim);
}

.rf-wave-track__pips {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.rf-wave-pip {
    width: 24px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--rf-border);
    margin: 0 4px;
    align-items: center;
    justify-content: center;
}

.rf-wave-pip__icon {
    font-size: 14px;
    color: var(--rf-danger-text);
    -unity-text-align: middle-center;
}

.rf-wave-pip--done {
    background-color: var(--rf-accent);
}

.rf-wave-pip--now {
    width: 36px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--rf-text);
    border-width: 2px;
    border-color: var(--rf-accent);
}

.rf-wave-pip--boss {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(60, 20, 18);
    border-width: 2px;
    border-color: var(--rf-boss);
}

.rf-wave-pip--boss.rf-wave-pip--done {
    background-color: var(--rf-accent);
    border-color: var(--rf-accent);
}

.rf-wave-pip--boss.rf-wave-pip--done .rf-wave-pip__icon {
    color: var(--rf-text-on-accent);
}

.rf-wave-pip--boss.rf-wave-pip--now {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: var(--rf-boss);
    border-color: var(--rf-text);
}

.rf-wave-pip--boss.rf-wave-pip--now .rf-wave-pip__icon {
    color: var(--rf-text);
    font-size: 16px;
}

.rf-wave-pip--best {
    border-width: 2px;
    border-color: var(--rf-accent-bright);
}

.rf-wave-track__info {
    min-width: 140px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.rf-wave-track__info-icon {
    font-size: 15px;
    color: var(--rf-accent-bright);
    margin-right: 8px;
}

.rf-wave-track__info-text {
    font-size: 17px;
    color: var(--rf-accent-bright);
}

.rf-wave-track__info--boss .rf-wave-track__info-icon,
.rf-wave-track__info--boss .rf-wave-track__info-text {
    color: var(--rf-danger-text);
}

.rf-wave-track__info--newbest {
    min-width: 0;
    background-color: var(--rf-accent-bright);
    border-radius: 4px;
    padding: 3px 8px;
}

.rf-wave-track__info--newbest .rf-wave-track__info-icon,
.rf-wave-track__info--newbest .rf-wave-track__info-text {
    color: var(--rf-text-on-accent);
}

/* ---- the boss panel ---- */
/* the day's challenge under the track: its two twists */
.rf-wave-daily {
    flex-direction: row;
    align-items: center;
    width: 720px;
    height: 40px;
    margin-top: 8px;
    padding: 0 12px;
    background-color: var(--rf-daily-bg);
    border-width: 2px;
    border-color: var(--rf-daily-border);
    border-radius: 8px;
}

.rf-wave-daily__cap {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.rf-wave-daily__cap-icon {
    font-size: 15px;
    color: var(--rf-daily);
    margin-right: 8px;
}

.rf-wave-daily__cap-text {
    font-size: 15px;
    color: var(--rf-daily);
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-wave-daily__twist {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    margin-left: 8px;
    background-color: var(--rf-surface-raised);
    border-width: 2px;
    border-color: var(--rf-daily-border);
    border-radius: 6px;
}

.rf-wave-daily__twist-icon {
    font-size: 14px;
    color: var(--rf-daily);
    margin-right: 8px;
}

.rf-wave-daily__twist-name {
    font-size: 16px;
    color: var(--rf-text);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-wave-boss {
    width: 720px;
    margin-top: 8px;
    background-color: var(--rf-boss-bg);
    border-width: 2px;
    border-color: var(--rf-boss-border);
    border-radius: 8px;
    padding: 10px 16px 14px 16px;
}

.rf-wave-boss__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.rf-wave-boss__icon {
    font-size: 22px;
    color: var(--rf-health-low);
    margin-right: 10px;
}

.rf-wave-boss__name {
    font-size: 24px;
    color: var(--rf-boss-text);
    flex-grow: 1;
}

.rf-wave-boss__tag {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-radius: 4px;
}

.rf-wave-boss__tag-icon {
    font-size: 14px;
    margin-right: 6px;
}

.rf-wave-boss__tag-text {
    font-size: 15px;
    letter-spacing: 1px;
}

.rf-wave-boss__tag--adds {
    background-color: var(--rf-accent);
}

.rf-wave-boss__tag--adds .rf-wave-boss__tag-icon,
.rf-wave-boss__tag--adds .rf-wave-boss__tag-text {
    color: var(--rf-text-on-accent);
}

.rf-wave-boss__tag--enraged {
    background-color: var(--rf-danger);
}

.rf-wave-boss__tag--enraged .rf-wave-boss__tag-icon,
.rf-wave-boss__tag--enraged .rf-wave-boss__tag-text {
    color: var(--rf-text);
}

.rf-wave-boss__pct {
    width: 64px;
    font-size: 20px;
    color: var(--rf-text);
    -unity-text-align: middle-right;
}

.rf-wave-boss__bar {
    height: 26px;
    background-color: rgb(10, 9, 7);
    border-width: 2px;
    border-color: rgb(10, 9, 7);
    border-radius: 4px;
    overflow: hidden;
}

.rf-wave-boss__ghost,
.rf-wave-boss__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.rf-wave-boss__ghost {
    background-color: var(--rf-health-ghost);
}

.rf-wave-boss__fill {
    background-color: var(--rf-boss);
}

.rf-wave-boss__fill--enraged {
    background-color: var(--rf-enraged);
}

.rf-wave-boss__shine {
    position: absolute;
    left: 0;
    top: 0;
    height: 5px;
    width: 100%;
    background-color: var(--rf-health-shine);
}

.rf-wave-boss__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: rgba(255, 244, 214, 0.75);
}

.rf-wave-boss__tick--passed {
    background-color: rgba(255, 244, 214, 0.25);
}

/* ---- the boon vote ---- */
.rf-wave-boons {
    width: 720px;
    margin-top: 8px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-color: var(--rf-accent-dim);
    border-radius: 8px;
    padding: 12px 14px 10px 14px;
}

.rf-wave-boons__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 0 2px;
}

.rf-wave-boons__title {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--rf-accent);
    flex-grow: 1;
}

.rf-wave-boons__hint {
    font-size: 15px;
    color: var(--rf-text-dim);
}

.rf-wave-boons__row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    margin-top: 4px;
    padding: 0 12px 0 10px;
    background-color: var(--rf-surface);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: var(--rf-surface);
}

.rf-wave-boons__row--lead {
    background-color: rgb(54, 40, 20);
    border-left-color: var(--rf-accent);
}

.rf-wave-boons__cmd {
    width: 96px;
    font-size: 16px;
    color: var(--rf-accent);
    background-color: var(--rf-surface-raised);
    border-radius: 4px;
    -unity-text-align: middle-center;
    padding: 5px 0;
}

.rf-wave-boons__icon {
    width: 34px;
    margin-left: 10px;
    font-size: 20px;
    color: var(--rf-text-dim);
    -unity-text-align: middle-center;
}

.rf-wave-boons__name {
    font-size: 19px;
    color: var(--rf-text);
    margin-left: 6px;
    flex-shrink: 0;
}

.rf-wave-boons__effect {
    font-size: 16px;
    color: var(--rf-text-dim);
    margin-left: 10px;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rf-wave-boons__bar {
    width: 110px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(52, 47, 40);
    overflow: hidden;
    margin-left: 10px;
}

.rf-wave-boons__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--rf-text-dim);
}

.rf-wave-boons__votes {
    width: 40px;
    font-size: 22px;
    color: var(--rf-text-dim);
    -unity-text-align: middle-right;
}

.rf-wave-boons__row--lead .rf-wave-boons__name,
.rf-wave-boons__row--lead .rf-wave-boons__votes,
.rf-wave-boons__row--lead .rf-wave-boons__icon {
    color: var(--rf-accent-bright);
}

.rf-wave-boons__row--lead .rf-wave-boons__fill {
    background-color: var(--rf-accent);
}

/* ---- the leave warning ---- */
.rf-wave-leave {
    flex-direction: row;
    align-items: center;
    width: 720px;
    margin-top: 8px;
    padding: 12px 16px 14px 16px;
    background-color: rgb(46, 33, 14);
    border-width: 2px;
    border-color: var(--rf-accent);
    border-radius: 8px;
    overflow: hidden;
}

.rf-wave-leave--abandon {
    background-color: rgb(46, 14, 12);
    border-color: var(--rf-danger);
}

.rf-wave-leave__key {
    font-size: 17px;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-text);
    border-radius: 4px;
    padding: 4px 10px 2px 10px;
    border-bottom-width: 4px;
    border-bottom-color: var(--rf-text-dim);
    margin-right: 14px;
}

.rf-wave-leave__texts {
    flex-grow: 1;
}

.rf-wave-leave__main {
    font-size: 19px;
    color: var(--rf-text);
}

.rf-wave-leave__sub {
    font-size: 16px;
    color: var(--rf-text-dim);
    margin-top: 2px;
}

.rf-wave-leave__icon {
    font-size: 26px;
    color: var(--rf-accent);
    margin-left: 12px;
}

.rf-wave-leave--abandon .rf-wave-leave__icon {
    color: var(--rf-danger);
}

.rf-wave-leave__drain {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 100%;
    background-color: var(--rf-accent);
}

.rf-wave-leave--abandon .rf-wave-leave__drain {
    background-color: var(--rf-danger);
}

/* ---- downed ---- */
.rf-wave-down {
    width: 720px;
    margin-top: 8px;
    background-color: rgb(34, 10, 9);
    border-width: 3px;
    border-color: var(--rf-danger);
    border-radius: 8px;
    padding: 12px 18px 14px 18px;
}

.rf-wave-down__head {
    flex-direction: row;
    align-items: center;
}

.rf-wave-down__icon {
    font-size: 34px;
    color: var(--rf-danger);
    margin-right: 14px;
}

.rf-wave-down__title {
    font-size: 46px;
    color: var(--rf-health-low);
    flex-grow: 1;
}

.rf-wave-down__count {
    align-items: flex-end;
}

.rf-wave-down__num {
    font-size: 56px;
    color: var(--rf-text);
    -unity-text-align: middle-right;
}

.rf-wave-down__cap {
    font-size: 15px;
    color: var(--rf-text-dim);
}

.rf-wave-down__drain {
    height: 8px;
    border-radius: 4px;
    background-color: rgb(10, 9, 7);
    margin-top: 8px;
    overflow: hidden;
}

.rf-wave-down__drain-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: var(--rf-danger);
}

.rf-wave-down__revive {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.rf-wave-down__label {
    font-size: 19px;
    color: var(--rf-text);
    margin-right: 8px;
}

.rf-wave-down__cmd {
    font-size: 18px;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-radius: 4px;
    padding: 4px 10px 3px 10px;
}

.rf-wave-down__pips {
    flex-direction: row;
    align-items: center;
}

.rf-wave-down__pip {
    width: 26px;
    height: 14px;
    border-radius: 3px;
    background-color: var(--rf-border);
    margin-left: 5px;
}

.rf-wave-down__pip--on {
    background-color: var(--rf-accent);
}

.rf-wave-down__votes {
    width: 72px;
    font-size: 22px;
    color: var(--rf-text);
    -unity-text-align: middle-right;
}

.rf-wave-down__healer {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.rf-wave-down__healer-icon {
    font-size: 20px;
    color: var(--rf-success);
    margin-right: 10px;
}

.rf-wave-down__healer-text {
    font-size: 17px;
    color: var(--rf-success-bright);
    margin-right: 12px;
}

.rf-wave-down__healer-bar {
    flex-grow: 1;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(52, 47, 40);
    overflow: hidden;
}

.rf-wave-down__healer-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--rf-success);
}

.rf-wave-down__healer-pct {
    width: 64px;
    font-size: 18px;
    color: var(--rf-success-bright);
    -unity-text-align: middle-right;
}

.rf-wave-down-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 10px;
    border-color: rgb(229, 72, 77);
}

/* ---- the result card ---- */
.rf-wave-result {
    width: 760px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-color: var(--rf-border-strong);
    border-radius: 10px;
    overflow: hidden;
}

.rf-wave-result__header {
    height: 92px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--rf-boss-border);
}

.rf-wave-result__icon {
    font-size: 36px;
    margin-right: 16px;
    color: var(--rf-text);
}

.rf-wave-result__title {
    font-size: 34px;
    color: var(--rf-text);
}

.rf-wave-result__header--held {
    background-color: var(--rf-accent);
}

.rf-wave-result__header--held .rf-wave-result__icon,
.rf-wave-result__header--held .rf-wave-result__title {
    color: var(--rf-text-on-accent);
}

.rf-wave-result__header--retreat {
    background-color: var(--rf-surface-raised);
}

.rf-wave-result__header--retreat .rf-wave-result__icon,
.rf-wave-result__header--retreat .rf-wave-result__title {
    color: var(--rf-accent-bright);
}

.rf-wave-result__body {
    padding: 16px 18px 20px 18px;
}

.rf-wave-result__stats {
    flex-direction: row;
    margin: 0 -6px;
}

.rf-wave-result__stat {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
    background-color: var(--rf-surface);
    border-radius: 6px;
    padding: 10px 0;
    align-items: center;
}

.rf-wave-result__stat-num {
    font-size: 52px;
    color: var(--rf-text);
    -unity-text-align: middle-center;
}

.rf-wave-result__stat-cap {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--rf-text-dim);
}

.rf-wave-result__best {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin-top: 12px;
    border-radius: 6px;
    background-color: var(--rf-accent-bright);
}

.rf-wave-result__best-icon {
    font-size: 22px;
    margin: 0 14px;
    color: var(--rf-text-on-accent);
}

.rf-wave-result__best-main {
    font-size: 26px;
    color: var(--rf-text-on-accent);
}

.rf-wave-result__best-sub {
    font-size: 17px;
    margin-left: 12px;
    color: var(--rf-text-on-accent);
}

.rf-wave-result__best--plain {
    background-color: var(--rf-surface);
    height: 44px;
}

.rf-wave-result__best--plain .rf-wave-result__best-main {
    font-size: 20px;
    color: var(--rf-text-dim);
}

.rf-wave-result__chips {
    flex-direction: row;
    margin-top: 10px;
}

.rf-wave-result__chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--rf-surface-raised);
    border-radius: 6px;
    padding: 9px 14px;
    margin-right: 10px;
}

.rf-wave-result__chip-icon {
    font-size: 18px;
    color: var(--rf-accent);
    margin-right: 10px;
}

.rf-wave-result__chip-text {
    font-size: 18px;
    color: var(--rf-text);
}

.rf-wave-result__chest {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    background-color: var(--rf-gold-bg);
    border-width: 2px;
    border-color: var(--rf-accent-dim);
    border-radius: 6px;
    padding: 10px 16px;
}

.rf-wave-result__chest--none {
    background-color: var(--rf-surface);
    border-color: var(--rf-border);
}

.rf-wave-result__chest-icon {
    font-size: 28px;
    color: var(--rf-accent);
    margin-right: 14px;
}

.rf-wave-result__chest--none .rf-wave-result__chest-icon {
    color: var(--rf-text-faint);
}

.rf-wave-result__chest-name {
    font-size: 20px;
    color: var(--rf-text);
    flex-grow: 1;
}

.rf-wave-result__chest--none .rf-wave-result__chest-name {
    font-size: 17px;
    color: var(--rf-text-dim);
}

.rf-wave-result__chest-what {
    font-size: 20px;
    color: var(--rf-accent-bright);
}

.rf-wave-result__timer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 100%;
    background-color: var(--rf-accent);
}

/* ---- the banners ---- */
.rf-wave-banner {
    position: absolute;
    top: 470px;
    left: 0;
    right: 0;
    align-items: center;
}

.rf-wave-banner__band {
    min-width: 1100px;
    padding: 12px 64px 16px 64px;
    background-color: var(--rf-bg);
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--rf-accent);
    align-items: center;
}

.rf-wave-banner__cap {
    font-size: 18px;
    letter-spacing: 5px;
    color: var(--rf-accent);
}

.rf-wave-banner__main {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.rf-wave-banner__text {
    font-size: 68px;
    color: var(--rf-text);
}

.rf-wave-banner__icon {
    font-size: 44px;
    color: var(--rf-accent);
    margin: 0 22px;
}

.rf-wave-banner__sub {
    font-size: 20px;
    color: var(--rf-text-dim);
    margin-top: 2px;
}

.rf-wave-banner--boss .rf-wave-banner__band {
    background-color: var(--rf-boss-bg);
    border-color: var(--rf-danger);
}

.rf-wave-banner--boss .rf-wave-banner__cap {
    color: var(--rf-danger-text);
}

.rf-wave-banner--boss .rf-wave-banner__text {
    color: var(--rf-boss-text);
}

.rf-wave-banner--boss .rf-wave-banner__icon {
    color: var(--rf-danger);
}

.rf-wave-banner--held .rf-wave-banner__band,
.rf-wave-banner--up .rf-wave-banner__band {
    border-color: var(--rf-success);
}

.rf-wave-banner--held .rf-wave-banner__cap,
.rf-wave-banner--held .rf-wave-banner__icon,
.rf-wave-banner--up .rf-wave-banner__icon,
.rf-wave-banner--up .rf-wave-banner__text {
    color: var(--rf-success-bright);
}

.rf-wave-banner--gold .rf-wave-banner__band {
    background-color: var(--rf-gold-bg);
    border-color: var(--rf-accent-bright);
}

.rf-wave-banner--gold .rf-wave-banner__cap,
.rf-wave-banner--gold .rf-wave-banner__text,
.rf-wave-banner--gold .rf-wave-banner__icon {
    color: var(--rf-accent-bright);
}

/* chat's part (HeroHelpersHud): the top helpers on the right, the feed under the wave line, the cheer bonus */
.rf-hero-helpers {
    position: absolute;
    right: 16px;
    top: 228px;
    width: 240px;
    padding: 8px 12px 10px 12px;
    background-color: rgba(14, 12, 10, 0.82);
    border-right-width: 3px;
    border-right-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
}

.rf-hero-helpers__title {
    font-size: 15px;
    color: var(--rf-accent-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.rf-hero-helpers__row {
    margin-bottom: 6px;
}

.rf-hero-helpers__name {
    font-size: 15px;
    color: var(--rf-text);
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.rf-hero-helpers__line {
    font-size: 13px;
    color: rgb(214, 204, 188);
    white-space: normal;
}

.rf-hero-feed {
    position: absolute;
    /* above the skill bar: the wave column at the top grows with the boss, the vote and the warnings */
    top: auto;
    bottom: 230px;
    left: 0;
    right: 0;
    align-items: center;
}

.rf-hero-feed__line {
    font-size: 16px;
    color: rgb(255, 236, 170);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    margin-bottom: 2px;
}

.rf-hero-style__cheer {
    margin-left: 6px;
    margin-right: 2px;
    font-size: 12px;
    color: rgb(255, 220, 90);
    -unity-font-style: bold;
}

/* ---- Ravebridge -----------------------------------------------------------------------------------------
   RavebridgeView: while the event runs, a panel in the top left corner (docs/mockups: the user's pick, playtest 13):
   the title, who is played, the time and who is there, and big buttons (Play a character, or Enter hero mode and Stop
   playing; End Ravebridge). It folds into a slim strip (rf-rbp--collapsed) once the character walks off, so it never
   sits over the game. Under it the key chips for a while after play starts. */

/* Low in the left corner, above the bot's status chip (the players list has the top left, the user, 2026-11-03). */
.rf-rbp-wrap {
    position: absolute;
    bottom: 64px;
    left: 14px;
    align-items: flex-start;
}



.rf-rbp {
    /* wide enough for "End Ravebridge for everyone" on one line (the user, 2026-11-03) */
    width: 460px;
    padding: 14px 16px 16px 16px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-top-width: 3px;
    border-color: var(--rf-accent-dim);
    border-top-color: var(--rf-accent);
    border-radius: 10px;
}

.rf-rbp--collapsed {
    width: auto;
    padding: 6px 8px 6px 12px;
}

.rf-rbp__head {
    flex-direction: row;
    align-items: center;
}

.rf-rbp__icon {
    font-size: 22px;
    color: var(--rf-accent);
    margin-right: 10px;
}

.rf-rbp--collapsed .rf-rbp__icon {
    font-size: 16px;
    margin-right: 8px;
}

.rf-rbp__title {
    flex-grow: 1;
    font-size: 24px;
    color: var(--rf-text);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-rbp--collapsed .rf-rbp__title {
    flex-grow: 0;
    font-size: 16px;
}

.rf-rbp__strip-info {
    margin-left: 10px;
    margin-right: 12px;
    max-width: 280px;
    font-size: 15px;
    color: var(--rf-text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-rbp__icon-button {
    width: 30px;
    height: 30px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 14px;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
}

.rf-rbp__icon-button:hover {
    color: var(--rf-text);
    background-color: var(--rf-surface-raised);
}

.rf-rbp__icon-button--on {
    color: var(--rf-accent-bright);
}

.rf-rbp__body {
    margin-top: 10px;
}

.rf-rbp__playing {
    font-size: 19px;
    color: var(--rf-accent-bright);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-rbp__meta {
    margin-top: 2px;
    margin-bottom: 12px;
    font-size: 15px;
    color: var(--rf-text-dim);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-rbp__big {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 48px;
    margin: 8px 0 0 0;
    padding: 0 16px;
    background-color: var(--rf-surface);
    border-width: 2px;
    border-color: var(--rf-border-strong);
    border-radius: 8px;
}

.rf-rbp__big:hover {
    background-color: var(--rf-surface-raised);
    border-color: var(--rf-accent-dim);
}

.rf-rbp__big-icon {
    font-size: 18px;
    margin-right: 12px;
    color: var(--rf-text);
}

.rf-rbp__big-text {
    font-size: 19px;
    color: var(--rf-text);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-rbp__big--primary {
    height: 56px;
    margin-top: 0;
    background-color: var(--rf-accent);
    border-color: var(--rf-accent-bright);
}

.rf-rbp__big--primary:hover {
    background-color: var(--rf-accent-bright);
    border-color: var(--rf-accent-bright);
}

.rf-rbp__big--primary .rf-rbp__big-icon,
.rf-rbp__big--primary .rf-rbp__big-text {
    color: var(--rf-text-on-accent);
}

.rf-rbp__big--primary .rf-rbp__big-text {
    font-size: 21px;
}

.rf-rbp__big--danger {
    border-color: rgb(150, 40, 40);
    background-color: rgb(40, 18, 18);
}

.rf-rbp__big--danger:hover {
    border-color: rgb(210, 60, 60);
    background-color: rgb(60, 22, 22);
}

.rf-rbp__big--danger .rf-rbp__big-icon,
.rf-rbp__big--danger .rf-rbp__big-text {
    color: rgb(240, 96, 90);
}

/* the folded strip's one button: Hero mode (or Play) */
.rf-rbp__strip-action {
    height: 32px;
    margin: 0 4px 0 0;
    padding: 0 12px;
    background-color: var(--rf-accent);
    border-color: var(--rf-accent-bright);
    border-radius: 6px;
}

.rf-rbp__strip-action:hover {
    background-color: var(--rf-accent-bright);
}

.rf-rbp__strip-action .rf-rbp__big-icon {
    font-size: 13px;
    margin-right: 8px;
    color: var(--rf-text-on-accent);
}

.rf-rbp__strip-action .rf-rbp__big-text {
    font-size: 15px;
    color: var(--rf-text-on-accent);
}

.rf-rbp__extras {
    flex-direction: row;
    margin-top: 10px;
}

.rf-rbp__small {
    height: 32px;
    margin: 0 8px 0 0;
    padding: 0 14px;
    font-size: 15px;
    color: var(--rf-text);
    background-color: var(--rf-surface);
    border-width: 2px;
    border-color: var(--rf-border-strong);
    border-radius: 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-rbp__small:hover {
    border-color: var(--rf-accent-dim);
    background-color: var(--rf-surface-raised);
}

/* the keys: a row of chips under the panel */
/* The hero's keys, bottom centre over the skill bar and the orbs beside it. */
.rf-rbp-keys {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 240px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.rf-rbp-key {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 6px 4px;
    padding: 4px 12px 4px 4px;
    background-color: rgb(20, 18, 15);
    border-width: 1px;
    border-color: rgba(214, 170, 40, 0.85);
    border-radius: 8px;
}

.rf-rbp-key__key {
    min-width: 26px;
    height: 26px;
    padding: 0 7px;
    margin-right: 8px;
    font-size: 14px;
    color: rgb(245, 236, 214);
    -unity-text-align: middle-center;
    background-color: rgb(34, 30, 24);
    border-width: 1px;
    border-color: rgb(214, 170, 40);
    border-radius: 5px;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-rbp-key__text {
    font-size: 14px;
    color: rgb(235, 225, 200);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-rb-panel {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    max-width: 900px;
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    background-color: rgba(20, 18, 15, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-rb-panel .rf-rb-button {
    margin-top: var(--rf-space-1);
    margin-bottom: var(--rf-space-1);
}

.rf-rb-panel__text {
    font-size: 14px;
    color: var(--rf-text-dim);
}

.rf-rb-name {
    width: 260px;
    margin-right: var(--rf-space-2);
}

.rf-rb-name > .unity-label {
    min-width: 0;
    margin-right: var(--rf-space-2);
    font-size: 14px;
    color: var(--rf-text-dim);
}

.rf-rb-name .unity-base-text-field__input {
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 14px;
    color: var(--rf-text);
    background-color: var(--rf-surface);
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: var(--rf-radius);
    border-top-right-radius: var(--rf-radius);
    border-bottom-left-radius: var(--rf-radius);
    border-bottom-right-radius: var(--rf-radius);
}

/* the "Who plays?" window: the quest window's look, narrower, a little lower */
.rf-rb-window {
    /* solid, so the island behind does not show through the cards; two portrait cards wide (the user's mockup) */
    background-color: rgb(20, 18, 15);
    top: 11%;
    width: 780px;
    margin-left: -390px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* ---- The "Who plays?" window (RavebridgeView), 2026-11-03: the opening for chat on top, portrait cards under it --- */
.rf-rbw__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.rf-rb-window .rf-rbw__castle {
    font-size: 30px;
    color: rgb(236, 190, 52);
    margin-right: 12px;
}

.rf-rb-window .rf-rbw__title {
    flex-grow: 1;
    font-size: 30px;
    color: rgb(245, 236, 214);
}

.rf-rb-window .rf-rbw__close {
    width: 34px;
    height: 34px;
    font-size: 18px;
    color: rgb(200, 190, 170);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-rb-window .rf-rbw__close:hover {
    color: rgb(255, 214, 90);
}

/* the line under the title that drains until the window goes by itself (as the observer's does) */
.rf-rbw__timer {
    height: 3px;
    margin-top: -4px;
    margin-bottom: 12px;
    background-color: rgba(214, 170, 40, 0.18);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.rf-rbw__timer-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(236, 190, 52);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.rf-rbw__viewers {
    margin-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgb(32, 28, 22);
    border-left-width: 3px;
    border-left-color: rgb(236, 190, 52);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-rb-window .rf-rbw__viewers-line {
    font-size: 17px;
    color: rgb(235, 225, 200);
    white-space: normal;
}

.rf-rb-window .rf-rbw__viewers-join {
    margin-top: 6px;
    font-size: 19px;
    color: rgb(245, 236, 214);
    white-space: normal;
}

.rf-rb-window .rf-rbw__section {
    font-size: 18px;
    color: rgb(236, 190, 52);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    margin-bottom: 8px;
}

.rf-rbw__cards {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.rf-rbw-card {
    width: 340px;
    margin-left: 7px;
    margin-right: 7px;
    margin-bottom: 8px;
    background-color: rgb(28, 25, 20);
    overflow: hidden;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(214, 170, 40, 0.55);
    border-right-color: rgba(214, 170, 40, 0.55);
    border-top-color: rgba(214, 170, 40, 0.55);
    border-bottom-color: rgba(214, 170, 40, 0.55);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.rf-rbw-card:hover {
    border-left-color: rgb(236, 190, 52);
    border-right-color: rgb(236, 190, 52);
    border-top-color: rgb(236, 190, 52);
    border-bottom-color: rgb(236, 190, 52);
}

.rf-rbw-card__portrait {
    height: 190px;
    align-items: center;
    justify-content: center;
    background-color: rgb(46, 36, 20);
    -unity-background-scale-mode: scale-and-crop;
}

.rf-rb-window .rf-rbw-card__silhouette {
    font-size: 120px;
    color: rgb(18, 15, 11);
}

.rf-rb-window .rf-rbw-card__plus {
    position: absolute;
    font-size: 52px;
    color: rgb(236, 190, 52);
}

.rf-rbw-card__body {
    flex-grow: 1;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
}

.rf-rb-window .rf-rbw-card__name {
    font-size: 24px;
    color: rgb(245, 236, 214);
}

.rf-rb-window .rf-rbw-card__kind {
    margin-top: 2px;
    font-size: 16px;
    color: rgb(236, 190, 52);
}

.rf-rbw-card__rule {
    align-self: stretch;
    height: 1px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: rgba(214, 170, 40, 0.35);
}

.rf-rb-window .rf-rbw-card__line {
    font-size: 15px;
    color: rgb(225, 214, 190);
    white-space: normal;
    -unity-text-align: middle-center;
}

.rf-rbw-card__buttons {
    align-self: stretch;
    margin-top: 12px;
}

.rf-rb-window .rf-rbw-btn {
    height: 40px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
    font-size: 17px;
    color: rgb(236, 190, 52);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-rb-window .rf-rbw-btn:hover {
    background-color: rgba(214, 170, 40, 0.15);
}

.rf-rb-window .rf-rbw-btn--primary {
    color: rgb(20, 18, 15);
    background-color: rgb(236, 190, 52);
}

.rf-rb-window .rf-rbw-btn--primary:hover {
    background-color: rgb(255, 214, 90);
}

.rf-rbw-card__small {
    flex-direction: row;
}

.rf-rb-window .rf-rbw-card__small .rf-rbw-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 32px;
    font-size: 14px;
    margin-left: 3px;
    margin-right: 3px;
}

.rf-rbw__foot {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(214, 170, 40, 0.3);
}

.rf-rb-window .rf-rbw__foot-icon {
    font-size: 16px;
    color: rgb(236, 190, 52);
    margin-right: 8px;
}

.rf-rb-window .rf-rbw__hint {
    font-size: 14px;
    color: rgb(200, 190, 170);
    white-space: normal;
    flex-shrink: 1;
}

.rf-rb-window__content {
    margin-top: var(--rf-space-1);
    margin-bottom: var(--rf-space-2);
}

/* ---- The quest window, 2026-10-31 -------------------------------------------------------------------------
   StreamQuestView's window in the look of the user's mockups: picture cards, reward columns, a story card with
   its steps, and a footer per tab. Dragged by its header and resized from its corner (DraggableWindow), so it
   is placed by left and top instead of the centring margin the "Who plays?" window keeps. Pictures: QuestArt. */

.rf-squest.rf-squest--window {
    left: 24%;
    top: 10%;
    /* solid: the glass's 3 % let the world show through plainly behind its cards */
    background-color: var(--rf-bg);
    width: 900px;
    max-height: 90%;
    margin-left: 0;
    padding-top: var(--rf-space-5);
    padding-bottom: 0;
    padding-left: 28px;
    padding-right: 28px;
}

.rf-squest--window .unity-label {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.rf-squest--window .rf-squest__header {
    flex-shrink: 0;
    margin-bottom: var(--rf-space-3);
}

.rf-squest--window .rf-squest__title {
    font-size: 30px;
}

.rf-squest--window .rf-squest-tabs {
    margin-bottom: var(--rf-space-5);
}

.rf-squest--window .rf-squest-tab {
    height: 50px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 20px;
}

.rf-squest--window .rf-squest__scroll {
    max-height: none;
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-squest__error {
    flex-shrink: 0;
    margin-top: var(--rf-space-2);
}

/* bold titles in the real B cut */
.rf-squest--window .rf-qheading,
.rf-squest--window .rf-qcard__title,
.rf-squest--window .rf-qamount__text,
.rf-squest--window .rf-qbadge,
.rf-squest--window .rf-qstory__title,
.rf-squest--window .rf-qempty__title,
.rf-squest--window .rf-qbudget__value,
.rf-squest--window .rf-qpost__text,
.rf-squest--window .rf-qdone__title,
.rf-squest--window .rf-qobjective__task,
.rf-squest--window .rf-qobjective__count,
.rf-squest--window .rf-qcard__count,
.rf-squest--window .rf-squest__footer-strong {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
}

.rf-squest--window .rf-qheading {
    font-size: 27px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-squest--window .rf-qheading__sub {
    margin-top: var(--rf-space-1);
    margin-bottom: var(--rf-space-4);
    font-size: 19px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest--window .rf-qsection {
    margin-top: var(--rf-space-5);
    margin-bottom: var(--rf-space-3);
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qlabel {
    margin-bottom: 6px;
    font-size: 15px;
    letter-spacing: 1.5px;
    color: var(--rf-text-dim);
}

.rf-qdivider {
    /* 1px rounds to nothing at the panel's scale */
    width: 2px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: var(--rf-space-5);
    margin-right: var(--rf-space-5);
    background-color: var(--rf-border-strong);
}

/* ---- Pictures and icons */

.rf-qart--missing {
    align-items: center;
    justify-content: center;
    background-color: var(--rf-surface-raised);
}

.rf-squest--window .rf-qart__glyph {
    font-size: 44px;
    color: var(--rf-accent-dim);
}

.rf-qart-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-squest--window .rf-qart-icon--glyph {
    font-size: 20px;
    color: var(--rf-accent);
}

/* ---- Cards: a picture, the body, a button on the right */

.rf-qcard {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rf-space-3);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-4);
    padding-bottom: var(--rf-space-4);
    background-color: rgba(255, 244, 214, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qcard:hover {
    background-color: rgba(255, 244, 214, 0.06);
}

.rf-qcard--active {
    border-left-color: var(--rf-accent-dim);
    border-right-color: var(--rf-accent-dim);
    border-top-color: var(--rf-accent-dim);
    border-bottom-color: var(--rf-accent-dim);
    background-color: var(--rf-accent-wash);
}

.rf-qcard__picture {
    width: 196px;
    height: 150px;
    flex-shrink: 0;
    margin-right: var(--rf-space-5);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    overflow: hidden;
}

/* a cut out subject (a story's) stands on the card instead of filling a frame */
.rf-qcard__picture--plain {
    -unity-background-scale-mode: scale-to-fit;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.rf-qcard__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--rf-space-4);
}

.rf-squest--window .rf-qcard__title {
    flex-shrink: 1;
    font-size: 25px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-qcard__title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rf-squest--window .rf-qcard__count {
    margin-left: var(--rf-space-3);
    font-size: 22px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qcard__line {
    margin-top: var(--rf-space-1);
    font-size: 18px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest--window .rf-qcard__reward {
    margin-top: var(--rf-space-2);
    font-size: 17px;
    color: var(--rf-accent-bright);
    white-space: normal;
}

.rf-squest--window .rf-qcard__helpers {
    font-size: 17px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-qcard__chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.rf-squest--window .rf-qcard__button {
    min-width: 180px;
    height: 56px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    font-size: 20px;
}

/* "(clock) 120 min": an icon and a pill */
.rf-qchip {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin-top: var(--rf-space-2);
    margin-right: var(--rf-space-3);
}

.rf-squest--window .rf-qchip__icon {
    margin-right: var(--rf-space-2);
    font-size: 22px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qchip__text {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 17px;
    color: var(--rf-text);
    background-color: rgba(255, 244, 214, 0.06);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* VILLAGE (coins, resource) | HELPERS (coins) */
.rf-qrewards {
    flex-direction: row;
    margin-top: var(--rf-space-3);
}

.rf-qrewards__row {
    flex-direction: row;
    align-items: center;
}

.rf-qamount {
    flex-direction: row;
    align-items: center;
    margin-right: var(--rf-space-5);
}

.rf-squest--window .rf-qamount__text {
    margin-left: var(--rf-space-2);
    font-size: 23px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qbadge {
    align-self: flex-start;
    margin-bottom: var(--rf-space-1);
    font-size: 14px;
    letter-spacing: 1.5px;
    color: var(--rf-accent);
}

.rf-squest--window .rf-qbadge--solid {
    padding-left: var(--rf-space-2);
    padding-right: var(--rf-space-2);
    padding-top: 2px;
    padding-bottom: 2px;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* ---- Your quests: the loyalty points, the empty state */

.rf-qbudget {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rf-space-4);
    padding-left: var(--rf-space-5);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-4);
    padding-bottom: var(--rf-space-4);
    background-color: rgba(255, 244, 214, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qbudget__icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: var(--rf-space-5);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-qbudget__text {
    margin-right: var(--rf-space-6);
}

.rf-squest--window .rf-qbudget__label {
    font-size: 17px;
    color: var(--rf-text-dim);
}

.rf-qbudget__numbers {
    flex-direction: row;
    align-items: flex-end;
}

.rf-squest--window .rf-qbudget__value {
    font-size: 30px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qbudget__of {
    margin-left: var(--rf-space-2);
    margin-bottom: 3px;
    font-size: 19px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qbudget__track {
    flex-grow: 1;
    height: 14px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.rf-qempty {
    align-items: center;
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-4);
}

.rf-qempty__picture {
    width: 300px;
    height: 220px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-squest--window .rf-qempty__title {
    margin-top: var(--rf-space-3);
    font-size: 27px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qempty__sub {
    margin-top: var(--rf-space-2);
    margin-bottom: var(--rf-space-4);
    font-size: 19px;
    color: var(--rf-text-dim);
}

.rf-qempty__post-row {
    align-items: center;
    margin-top: var(--rf-space-2);
}

.rf-qempty__kinds {
    flex-direction: row;
    align-items: center;
    margin-top: var(--rf-space-4);
}

.rf-qempty__kinds .rf-qchip {
    margin-top: 0;
    margin-right: 0;
}

.rf-squest--window .rf-qempty__kinds .rf-qchip__icon {
    color: var(--rf-accent);
}

.rf-squest--window .rf-qempty__kinds .rf-qchip__text {
    padding-left: var(--rf-space-1);
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-squest--window .rf-qpost {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 300px;
    height: 60px;
    margin-left: 0;
    margin-right: 0;
}

.rf-squest--window .rf-qpost__icon {
    margin-right: var(--rf-space-4);
    font-size: 22px;
    color: var(--rf-text-on-accent);
}

.rf-squest--window .rf-qpost__text {
    font-size: 21px;
    color: var(--rf-text-on-accent);
}

/* ---- Village: the active story card */

.rf-qstory {
    margin-bottom: var(--rf-space-3);
    padding-left: var(--rf-space-5);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-4);
    padding-bottom: var(--rf-space-4);
    background-color: rgba(232, 163, 61, 0.07);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-accent-dim);
    border-right-color: var(--rf-accent-dim);
    border-top-color: var(--rf-accent-dim);
    border-bottom-color: var(--rf-accent-dim);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qstory__head {
    flex-direction: row;
    justify-content: space-between;
    padding-bottom: var(--rf-space-4);
    margin-bottom: var(--rf-space-4);
    border-bottom-width: 1px;
    border-bottom-color: var(--rf-divider);
}

.rf-qstory__names {
    flex-shrink: 1;
}

.rf-squest--window .rf-qstory__title {
    margin-top: var(--rf-space-1);
    font-size: 32px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-qstory__steps {
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: var(--rf-space-4);
}

.rf-squest--window .rf-qstory__step {
    margin-bottom: var(--rf-space-3);
    font-size: 18px;
    color: var(--rf-text-dim);
}

.rf-qdots {
    flex-direction: row;
    align-items: center;
}

.rf-qdot {
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-text-faint);
    border-right-color: var(--rf-text-faint);
    border-top-color: var(--rf-text-faint);
    border-bottom-color: var(--rf-text-faint);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.rf-qdot--done,
.rf-qdot--current {
    background-color: var(--rf-accent);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-qdot--current {
    width: 24px;
    height: 24px;
    border-left-color: var(--rf-accent-bright);
    border-right-color: var(--rf-accent-bright);
    border-top-color: var(--rf-accent-bright);
    border-bottom-color: var(--rf-accent-bright);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.rf-squest--window .rf-qdot__tick {
    font-size: 11px;
    color: var(--rf-text-on-accent);
}

.rf-qdots__line {
    width: 16px;
    height: 2px;
    background-color: var(--rf-text-faint);
}

.rf-qdots__line--done {
    background-color: var(--rf-accent);
}

.rf-qstory__body {
    flex-direction: row;
}

.rf-qstory__picture {
    width: 270px;
    height: 230px;
    flex-shrink: 0;
    margin-right: var(--rf-space-5);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-qstory__right {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-qstory__npc {
    margin-top: var(--rf-space-1);
    font-size: 18px;
    color: var(--rf-accent);
}

.rf-squest--window .rf-qstory__line {
    margin-top: var(--rf-space-2);
    margin-bottom: var(--rf-space-3);
    font-size: 19px;
    -unity-font-style: italic;
    color: var(--rf-text);
    white-space: normal;
}

.rf-qobjective {
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-4);
    padding-bottom: var(--rf-space-3);
    background-color: rgba(0, 0, 0, 0.25);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-qobjective__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--rf-space-1);
}

.rf-squest--window .rf-qobjective__task {
    flex-shrink: 1;
    font-size: 20px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-squest--window .rf-qobjective__count {
    margin-left: var(--rf-space-3);
    font-size: 26px;
    color: var(--rf-text);
}

.rf-qobjective .rf-squest-track {
    height: 12px;
    margin-top: var(--rf-space-3);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-qobjective__foot {
    flex-direction: row;
    align-items: center;
    margin-top: var(--rf-space-2);
}

.rf-qobjective__helpers {
    flex-shrink: 1;
}

.rf-squest--window .rf-qobjective__helpers .rf-qchip__text {
    padding-left: 0;
    font-size: 16px;
    color: var(--rf-text-dim);
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-squest--window .rf-qobjective__helpers .rf-qchip__icon {
    font-size: 18px;
}

.rf-squest--window .rf-squest-chip.rf-qghost {
    height: 38px;
    margin-top: var(--rf-space-2);
    padding-left: 18px;
    padding-right: 18px;
    font-size: 17px;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.rf-squest--window .rf-squest-chip.rf-qghost:hover {
    color: var(--rf-danger);
    border-left-color: var(--rf-danger);
    border-right-color: var(--rf-danger);
    border-top-color: var(--rf-danger);
    border-bottom-color: var(--rf-danger);
}

/* ---- Village: finished stories, one line each */

.rf-qdone {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--rf-space-2);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-2);
    padding-bottom: var(--rf-space-2);
    background-color: rgba(255, 244, 214, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-qdone__picture {
    width: 96px;
    height: 72px;
    flex-shrink: 0;
    margin-right: var(--rf-space-5);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-qdone .rf-qart__glyph {
    font-size: 28px;
}

.rf-qdone__names {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-qdone__title {
    font-size: 21px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qdone__npc {
    margin-top: var(--rf-space-1);
    font-size: 17px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qdone__tick {
    margin-right: var(--rf-space-2);
    font-size: 26px;
    color: var(--rf-success);
}

.rf-squest--window .rf-qdone__state {
    font-size: 19px;
    color: var(--rf-success);
}

/* ---- The footer: a line, an icon and a short text per tab */

.rf-squest__footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 64px;
    margin-top: var(--rf-space-3);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
    padding-left: var(--rf-space-2);
    border-top-width: 1px;
    border-top-color: var(--rf-border);
}

.rf-squest--window .rf-squest__footer-icon {
    margin-right: var(--rf-space-3);
    font-size: 24px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-squest__footer-strong {
    font-size: 19px;
    color: var(--rf-text);
}

.rf-squest--window .rf-squest__footer-text {
    flex-shrink: 1;
    font-size: 17px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-squest__footer-picture {
    width: 96px;
    height: 60px;
    flex-shrink: 0;
    margin-right: var(--rf-space-4);
    -unity-background-scale-mode: scale-to-fit;
}

.rf-squest__footer .rf-qdivider {
    height: 28px;
    align-self: center;
}

/* stretching gave the lines no height in a row whose height comes from its labels */
.rf-qrewards .rf-qdivider {
    height: 52px;
    align-self: center;
}

.rf-qempty__kinds .rf-qdivider {
    height: 26px;
    align-self: center;
}

.rf-squest--window .rf-window__grip {
    right: 6px;
    bottom: 6px;
}

/* ---- The post a quest form, 2026-10-31 --------------------------------------------------------------------
   StreamerQuestPanel's form after the user's mockup: two cards side by side (never wrapped: a wrapping row is
   measured as if its cards were stacked, which left a card's height empty under the form), option cards for the kind, dropdowns and number fields with arrows, what posting sets aside,
   and the item dialog laid over the window with its own list and quantity. */

.rf-squest--window .rf-qform__label,
.rf-squest--window .rf-qform__title,
.rf-squest--window .rf-qkind__title,
.rf-squest--window .rf-qitem__name,
.rf-squest--window .rf-qreserved__title,
.rf-squest--window .rf-qreserved__amount,
.rf-squest--window .rf-qpick__name {
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
    -unity-font-style: normal;
}

.rf-qform__top {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--rf-space-2);
}

.rf-squest--window .rf-qform__back {
    width: 44px;
    height: 44px;
    margin-left: 0;
    margin-right: var(--rf-space-3);
    font-size: 24px;
    color: var(--rf-text);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-squest--window .rf-qform__back:hover {
    color: var(--rf-accent-bright);
    background-color: var(--rf-row-hover);
}

.rf-qform__columns {
    flex-direction: row;
    align-items: stretch;
}

.rf-qform__card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: var(--rf-space-3);
    margin-bottom: var(--rf-space-3);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-4);
    background-color: rgba(255, 244, 214, 0.03);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qform__card--rewards {
    flex-grow: 0.8;
    margin-right: 0;
}

.rf-squest--window .rf-qform__title {
    margin-bottom: var(--rf-space-3);
    font-size: 23px;
    color: var(--rf-text);
}

.rf-qform__rule {
    height: 2px;
    margin-top: var(--rf-space-3);
    margin-bottom: var(--rf-space-1);
    background-color: var(--rf-divider);
}

.rf-qform__label-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: var(--rf-space-3);
    margin-bottom: 6px;
}

.rf-squest--window .rf-qform__label {
    font-size: 18px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qform__optional {
    margin-left: var(--rf-space-2);
    font-size: 16px;
    color: var(--rf-text-faint);
}

.rf-squest--window .rf-qform__note {
    margin-top: 6px;
    font-size: 16px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-qform__pair {
    flex-direction: row;
}

.rf-qform__cell--wide {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--rf-space-3);
}

.rf-qform__cell--narrow {
    width: 38%;
    flex-shrink: 0;
}

.rf-squest--window .rf-qform__button {
    min-width: 130px;
    height: 48px;
    margin-left: 0;
    margin-right: 0;
    font-size: 18px;
}

/* the text fields of the form share one look */
.rf-squest--window .rf-squest-field {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* ---- Bounty or stream goal */

.rf-qform__kinds {
    flex-direction: row;
}

.rf-squest--window .rf-qkind {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    height: 80px;
    margin-left: 0;
    margin-right: var(--rf-space-2);
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    background-color: rgba(0, 0, 0, 0.25);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-squest--window .rf-qkind:last-child {
    margin-right: 0;
}

.rf-squest--window .rf-qkind:hover {
    background-color: var(--rf-row-hover);
}

.rf-squest--window .rf-qkind--active,
.rf-squest--window .rf-qkind--active:hover {
    background-color: var(--rf-accent-wash);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-squest--window .rf-qkind__icon {
    width: 36px;
    margin-right: var(--rf-space-3);
    font-size: 26px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qkind--active .rf-qkind__icon {
    color: var(--rf-accent);
}

.rf-qkind__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-qkind__title {
    font-size: 20px;
    color: var(--rf-text);
    -unity-text-align: middle-left;
}

.rf-squest--window .rf-qkind__sub {
    margin-top: 3px;
    font-size: 16px;
    color: var(--rf-text-dim);
    -unity-text-align: middle-left;
    white-space: normal;
}

.rf-qkind__radio {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rf-text-faint);
    border-right-color: var(--rf-text-faint);
    border-top-color: var(--rf-text-faint);
    border-bottom-color: var(--rf-text-faint);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

/* the dot of a picked radio: a thick ring of the window's colour inside the accent rim */
.rf-qkind--active .rf-qkind__radio {
    background-color: var(--rf-accent);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
}

/* ---- Dropdowns and their lists */

.rf-squest--window .rf-qdropdown {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    background-color: rgba(0, 0, 0, 0.35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-squest--window .rf-qdropdown:hover {
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-squest--window .rf-qdropdown__icon {
    width: 26px;
    margin-right: var(--rf-space-3);
    font-size: 19px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qdropdown__text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 18px;
    color: var(--rf-text);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rf-squest--window .rf-qdropdown__chevron {
    margin-left: var(--rf-space-2);
    font-size: 14px;
    color: var(--rf-text-dim);
}

/* a dropdown that reads as a line of text, "From the village treasury - 10,818 available" */
.rf-squest--window .rf-qdropdown--link {
    align-self: flex-start;
    height: 30px;
    margin-top: 6px;
    padding-left: 0;
    padding-right: var(--rf-space-1);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rf-squest--window .rf-qdropdown--link .rf-qdropdown__text {
    font-size: 16px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qdropdown--link:hover .rf-qdropdown__text,
.rf-squest--window .rf-qdropdown--link:hover .rf-qdropdown__chevron {
    color: var(--rf-accent-bright);
}

.rf-qpopup-catcher {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rf-qpopup {
    position: absolute;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(28, 25, 21);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-squest--window .rf-qpopup__row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--rf-space-3);
    padding-right: var(--rf-space-3);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-squest--window .rf-qpopup__row:hover {
    background-color: var(--rf-row-hover);
}

.rf-squest--window .rf-qpopup__row--active {
    background-color: var(--rf-accent-wash);
}

.rf-squest--window .rf-qpopup__icon {
    width: 24px;
    margin-right: var(--rf-space-3);
    font-size: 16px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qpopup__text {
    font-size: 16px;
    color: var(--rf-text);
    -unity-text-align: middle-left;
}

.rf-squest--window .rf-qpopup__row--active .rf-qpopup__text {
    color: var(--rf-accent-bright);
}

/* ---- Number fields with arrows, an icon box before some */

.rf-qnumber {
    flex-direction: row;
    align-items: stretch;
    height: 46px;
}

.rf-qnumber--short {
    width: 50%;
}

.rf-qnumber__iconbox {
    width: 46px;
    flex-shrink: 0;
    margin-right: var(--rf-space-2);
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-squest--window .rf-qnumber__field {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-qnumber__field > .unity-text-field__input,
.rf-squest--window .rf-qnumber__field .unity-base-text-field__input {
    height: 46px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.rf-qnumber__arrows {
    width: 36px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.35);
    border-left-width: 0;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-squest--window .rf-qnumber__arrow {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 11px;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: var(--rf-border-strong);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.rf-squest--window .rf-qnumber__arrow:hover {
    color: var(--rf-accent-bright);
    background-color: var(--rf-row-hover);
}

/* ---- The item on the form */

.rf-qitem {
    flex-direction: row;
    align-items: center;
    padding-right: var(--rf-space-2);
    background-color: rgba(0, 0, 0, 0.25);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-qitem__icon {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    margin-right: var(--rf-space-3);
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.3);
    border-right-width: 1px;
    border-right-color: var(--rf-border);
}

.rf-qitem__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-qitem__name {
    font-size: 19px;
    color: var(--rf-text);
    white-space: normal;
}

.rf-squest--window .rf-qitem__line {
    margin-top: 3px;
    font-size: 16px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qitem__change {
    height: 38px;
    margin-left: var(--rf-space-2);
    margin-right: 0;
    font-size: 15px;
}

.rf-squest--window .rf-qitem__remove {
    width: 38px;
    height: 38px;
    margin-left: var(--rf-space-2);
    margin-right: 0;
    font-size: 16px;
}

.rf-squest--window .rf-qitem-choose {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 60px;
    margin-left: 0;
    margin-right: 0;
    background-color: rgba(0, 0, 0, 0.2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-squest--window .rf-qitem-choose:hover {
    background-color: var(--rf-accent-wash);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-squest--window .rf-qitem-choose__icon {
    margin-right: var(--rf-space-3);
    font-size: 16px;
    color: var(--rf-accent);
}

.rf-squest--window .rf-qitem-choose__text {
    font-size: 17px;
    color: var(--rf-text);
}

/* ---- What posting sets aside */

.rf-qreserved {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--rf-space-4);
    padding-left: var(--rf-space-4);
    padding-right: var(--rf-space-4);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-3);
    background-color: rgba(255, 244, 214, 0.03);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qreserved__head {
    flex-shrink: 1;
    margin-right: var(--rf-space-2);
}

.rf-squest--window .rf-qreserved__title {
    font-size: 21px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qreserved__sub {
    margin-top: 3px;
    font-size: 16px;
    color: var(--rf-text-dim);
    white-space: normal;
}

.rf-qreserved__part {
    flex-direction: row;
    align-items: center;
}

.rf-qreserved__part .rf-qdivider {
    height: 40px;
    margin-left: var(--rf-space-4);
    margin-right: var(--rf-space-4);
}

.rf-squest--window .rf-qreserved__amount {
    margin-left: var(--rf-space-2);
    font-size: 20px;
    color: var(--rf-text);
}

.rf-squest--window .rf-qreserved__nothing {
    margin-left: var(--rf-space-5);
    font-size: 15px;
    color: var(--rf-text-faint);
    white-space: normal;
}

/* ---- The item dialog */

.rf-qmodal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 7, 5, 0.72);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qmodal__dialog {
    width: 92%;
    max-width: 760px;
    max-height: 94%;
    padding-left: var(--rf-space-5);
    padding-right: var(--rf-space-5);
    padding-top: var(--rf-space-4);
    padding-bottom: var(--rf-space-4);
    background-color: var(--rf-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-width: 3px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
    border-top-color: var(--rf-accent);
    border-top-left-radius: var(--rf-radius-lg);
    border-top-right-radius: var(--rf-radius-lg);
    border-bottom-left-radius: var(--rf-radius-lg);
    border-bottom-right-radius: var(--rf-radius-lg);
}

.rf-qmodal__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rf-qmodal__tools {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: var(--rf-space-3);
}

.rf-qmodal__tools .rf-qdropdown {
    min-width: 170px;
    margin-left: var(--rf-space-2);
}

.rf-qsearch {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
}

.rf-squest--window .rf-qsearch__icon {
    position: absolute;
    left: 14px;
    top: 13px;
    font-size: 17px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qsearch .rf-qsearch__field > .unity-text-field__input,
.rf-squest--window .rf-qsearch .rf-qsearch__field .unity-base-text-field__input {
    height: 46px;
    padding-left: 42px;
}

.rf-squest--window .rf-qmodal__list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
}

.rf-squest--window .rf-qpick {
    flex-direction: row;
    align-items: center;
    height: 76px;
    margin-left: 0;
    margin-right: var(--rf-space-2);
    margin-top: 0;
    margin-bottom: var(--rf-space-2);
    padding-left: 0;
    padding-right: var(--rf-space-4);
    background-color: rgba(255, 244, 214, 0.035);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border);
    border-right-color: var(--rf-border);
    border-top-color: var(--rf-border);
    border-bottom-color: var(--rf-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-squest--window .rf-qpick:hover {
    background-color: var(--rf-row-hover);
}

.rf-squest--window .rf-qpick--selected,
.rf-squest--window .rf-qpick--selected:hover {
    background-color: var(--rf-accent-wash);
    border-left-color: var(--rf-accent);
    border-right-color: var(--rf-accent);
    border-top-color: var(--rf-accent);
    border-bottom-color: var(--rf-accent);
}

.rf-qpick__icon {
    width: 76px;
    height: 74px;
    flex-shrink: 0;
    margin-right: var(--rf-space-4);
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.3);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.rf-qpick__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-squest--window .rf-qpick__name {
    font-size: 17px;
    color: var(--rf-text);
    -unity-text-align: middle-left;
}

.rf-squest--window .rf-qpick__category {
    margin-top: 3px;
    font-size: 14px;
    color: var(--rf-text-dim);
    -unity-text-align: middle-left;
}

.rf-squest--window .rf-qpick__owned {
    margin-left: var(--rf-space-3);
    font-size: 15px;
    color: var(--rf-text-dim);
}

.rf-squest--window .rf-qpick__tick {
    width: 28px;
    height: 28px;
    margin-left: var(--rf-space-4);
    font-size: 13px;
    color: var(--rf-text-on-accent);
    background-color: var(--rf-accent);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.rf-qmodal__foot {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin-top: var(--rf-space-2);
    padding-top: var(--rf-space-3);
    padding-bottom: var(--rf-space-2);
    border-top-width: 1px;
    border-top-color: var(--rf-border);
}

.rf-qmodal__foot-icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: var(--rf-space-3);
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.3);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.rf-qmodal__foot-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--rf-space-3);
}

.rf-qmodal__quantity {
    flex-shrink: 0;
}

.rf-qmodal__quantity .rf-qform__label-row {
    margin-top: 0;
}

.rf-qstepper {
    flex-direction: row;
    height: 44px;
}

.rf-squest--window .rf-qstepper__button {
    width: 46px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 15px;
    color: var(--rf-text);
    background-color: rgba(255, 244, 214, 0.06);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rf-border-strong);
    border-right-color: var(--rf-border-strong);
    border-top-color: var(--rf-border-strong);
    border-bottom-color: var(--rf-border-strong);
}

.rf-squest--window .rf-qstepper__button:hover {
    color: var(--rf-accent-bright);
    background-color: var(--rf-row-hover);
}

.rf-squest--window .rf-qstepper__field {
    width: 110px;
}

.rf-squest--window .rf-qstepper__field > .unity-text-field__input,
.rf-squest--window .rf-qstepper__field .unity-base-text-field__input {
    height: 44px;
    -unity-text-align: middle-center;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* the form's text fields at the mockup's size; the tall one keeps its own height */
.rf-squest--window .rf-squest-field > .unity-text-field__input,
.rf-squest--window .rf-squest-field .unity-base-text-field__input {
    height: 44px;
    padding-left: 14px;
    font-size: 17px;
}

.rf-squest--window .rf-squest-field--tall > .unity-text-field__input,
.rf-squest--window .rf-squest-field--tall .unity-base-text-field__input {
    height: 76px;
    padding-top: 10px;
    -unity-text-align: upper-left;
}

/* the dialog's buttons keep their size while its list gives up room */
.rf-qmodal__dialog .rf-squest-form__buttons {
    flex-shrink: 0;
    margin-top: var(--rf-space-3);
}

.rf-qmodal__head {
    flex-shrink: 0;
}

.rf-squest--window .rf-qreserved .rf-qart-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

/* F1's "nothing" (HUDController puts rf-hud-hidden on every document): the top column (the village bar, the XP boost,
   the event bars, the stream quest bar), the quest window and the details and meters windows step aside; the menu,
   settings and shop still open. */
.rf-hud-hidden .rf-top-column,
.rf-hud-hidden .rf-squest--window,
.rf-hud-hidden #details-window,
.rf-hud-hidden #island-window,
.rf-hud-hidden #enemy-window,
.rf-hud-hidden #meters-window {
    visibility: hidden;
}

/* ---- The quest window's Ravebridge tab (RavebridgeQuestPanel) */

.rf-rbq__characters {
    margin-bottom: var(--rf-space-3);
}

.rf-rbq__objective {
    margin-top: var(--rf-space-2);
}

.rf-rbq__begin .rf-qcard__picture {
    width: 120px;
    height: 96px;
}

/* The Mangrove island (MangroveView, docs/banana-island.md): its feed low on the left, its events' bar */
.rf-mfeed {
    position: absolute;
    left: 16px;
    bottom: 128px;
    width: 520px;
    flex-direction: column;
    align-items: flex-start;
}

.rf-mfeed__line {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(20, 18, 15, 0.94);
    border-left-width: 3px;
    border-left-color: var(--rf-accent);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-mfeed__glyph {
    width: 22px;
    font-size: 14px;
    color: var(--rf-accent);
    -unity-text-align: middle-center;
    margin-right: 6px;
}

.rf-mfeed__text {
    font-size: 17px;
    color: var(--rf-text);
    white-space: normal;
    flex-shrink: 1;
}

/* The Mangrove panel (MangroveView) under the village bar while something runs on the island: the title big, a
   progress line under it, a ring timer on the right; the chat command that joins in a strip of its own below, the
   command a gold chip in the sentence. Solid, like the other HUD panels. */
.rf-mbar {
    align-self: center;
    width: 560px;
    margin-top: var(--rf-space-2);
    background-color: rgb(20, 18, 15);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    overflow: hidden;
}

.rf-mbar__top {
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.rf-mbar .rf-mbar__icon {
    width: 44px;
    margin-right: 14px;
    font-size: 34px;
    -unity-text-align: middle-center;
    color: rgb(236, 190, 52);
}

.rf-mbar__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-mbar .rf-mbar__title {
    font-size: 30px;
    color: rgb(245, 236, 214);
    white-space: normal;
}

.rf-mbar .rf-mbar__line {
    font-size: 18px;
    color: rgb(245, 236, 214);
    margin-top: 4px;
}

.rf-mbar__track {
    height: 8px;
    margin-top: 10px;
    margin-right: 12px;
    background-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.rf-mbar__fill {
    height: 100%;
    width: 0;
    background-color: rgb(236, 190, 52);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rf-mbar__ring {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    align-items: center;
    justify-content: center;
}

.rf-mbar .rf-mbar__timer {
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(236, 190, 52);
}

.rf-mbar__cta {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 9px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(30, 27, 22);
    border-top-width: 2px;
    border-top-color: rgb(214, 170, 40);
}

.rf-mbar .rf-mbar__cta-text {
    font-size: 20px;
    color: rgb(245, 236, 214);
}

.rf-mbar .rf-mbar__cmd {
    font-size: 21px;
    -unity-text-align: middle-center;
    color: rgb(20, 18, 15);
    background-color: rgb(236, 190, 52);
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 3px;
    padding-bottom: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Under the regatta's standings: a hint while the race camera directs, the button back to it while the streamer has
   it by hand or watches something else, and its countdown. */
.rf-mstand__camera-note {
    margin-top: 8px;
    margin-left: 12px;
    margin-right: 12px;
    font-size: 13px;
    color: rgb(190, 180, 160);
    white-space: normal;
    -unity-text-align: middle-center;
}

.rf-mstand__camera-note--count {
    font-size: 15px;
    color: rgb(236, 190, 52);
}

.rf-mstand .rf-mstand__camera {
    margin-top: 8px;
    margin-left: 12px;
    margin-right: 12px;
    margin-bottom: 4px;
    height: 34px;
    font-size: 15px;
    color: rgb(20, 18, 15);
    background-color: rgb(236, 190, 52);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-mstand .rf-mstand__camera:hover {
    background-color: rgb(255, 214, 90);
}

/* The regatta's results (RegattaResultsPanel): in the middle of the screen when a race is over, a podium with the
   boats' pictures, the rest of the order, the standouts, the saboteurs and the pot; confetti over it. Fades in and out. */
.rf-mres-wrap {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    translate: 0 16px;
}

.rf-mres-wrap--shown {
    opacity: 1;
    translate: 0 0;
}

.rf-mres-confetti {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.rf-mres-confetti__piece {
    position: absolute;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.rf-mres {
    width: 780px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
    padding-bottom: 20px;
    background-color: rgb(20, 18, 15);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.rf-mres__head {
    flex-direction: row;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(214, 170, 40, 0.35);
}

.rf-mres .rf-mres__trophy {
    width: 64px;
    height: 64px;
    margin-right: 16px;
    font-size: 30px;
    color: rgb(236, 190, 52);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
}

.rf-mres .rf-mres__title {
    font-size: 38px;
    color: rgb(245, 236, 214);
}

.rf-mres .rf-mres__subtitle {
    font-size: 18px;
    color: rgb(225, 214, 190);
}

.rf-mres__podium {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    margin-bottom: 14px;
}

.rf-mres__step {
    width: 200px;
    align-items: center;
    margin-left: 7px;
    margin-right: 7px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-mres__step--gold {
    width: 220px;
    min-height: 228px;
    background-color: rgb(74, 58, 18);
    border-left-color: rgb(236, 190, 52);
    border-right-color: rgb(236, 190, 52);
    border-top-color: rgb(236, 190, 52);
    border-bottom-color: rgb(236, 190, 52);
}

.rf-mres__step--silver {
    min-height: 196px;
    background-color: rgb(52, 54, 58);
    border-left-color: rgb(176, 180, 188);
    border-right-color: rgb(176, 180, 188);
    border-top-color: rgb(176, 180, 188);
    border-bottom-color: rgb(176, 180, 188);
}

.rf-mres__step--bronze {
    min-height: 184px;
    background-color: rgb(66, 42, 24);
    border-left-color: rgb(196, 124, 62);
    border-right-color: rgb(196, 124, 62);
    border-top-color: rgb(196, 124, 62);
    border-bottom-color: rgb(196, 124, 62);
}

.rf-mres .rf-mres__crown {
    position: absolute;
    top: -22px;
    font-size: 26px;
    color: rgb(255, 210, 70);
}

.rf-mres .rf-mres__step-place {
    font-size: 26px;
    color: rgb(245, 236, 214);
}

.rf-mres__step--gold .rf-mres__step-place,
.rf-mres__step--gold .rf-mres__step-name {
    color: rgb(255, 214, 90);
}

.rf-mres__step--bronze .rf-mres__step-place,
.rf-mres__step--bronze .rf-mres__step-name {
    color: rgb(232, 168, 108);
}

.rf-mres__boat {
    width: 96px;
    height: 76px;
    margin-top: 2px;
    margin-bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.rf-mres__step--gold .rf-mres__boat {
    width: 112px;
    height: 92px;
}

.rf-mres .rf-mres__step-name {
    font-size: 21px;
    color: rgb(245, 236, 214);
}

.rf-mres .rf-mres__step-detail {
    font-size: 16px;
    color: rgb(225, 214, 190);
}

.rf-mres__list {
    margin-bottom: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.3);
    border-right-color: rgba(214, 170, 40, 0.3);
    border-top-color: rgba(214, 170, 40, 0.3);
    border-bottom-color: rgba(214, 170, 40, 0.3);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-mres__row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.rf-mres .rf-mres__place {
    width: 70px;
    font-size: 17px;
    color: rgb(236, 190, 52);
}

.rf-mres .rf-mres__name {
    flex-grow: 1;
    font-size: 17px;
    color: rgb(245, 236, 214);
}

.rf-mres .rf-mres__time {
    font-size: 17px;
    color: rgb(245, 236, 214);
}

.rf-mres .rf-mres__time--none {
    font-size: 16px;
    color: rgb(160, 150, 130);
}

.rf-mres__cards {
    flex-direction: row;
    margin-bottom: 14px;
}

.rf-mres__card {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 10px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.7);
    border-right-color: rgba(214, 170, 40, 0.7);
    border-top-color: rgba(214, 170, 40, 0.7);
    border-bottom-color: rgba(214, 170, 40, 0.7);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-mres .rf-mres__card-icon {
    width: 36px;
    margin-right: 8px;
    font-size: 24px;
}

.rf-mres .rf-mres__card-icon--hit { color: rgb(236, 80, 64); }
.rf-mres .rf-mres__card-icon--pick { color: rgb(120, 200, 230); }
.rf-mres .rf-mres__card-icon--rise { color: rgb(110, 210, 100); }
.rf-mres .rf-mres__card-icon--kraken { color: rgb(190, 120, 230); }

.rf-mres .rf-mres__card-title {
    font-size: 14px;
    color: rgb(225, 214, 190);
    white-space: normal;
}

.rf-mres .rf-mres__card-name,
.rf-mres .rf-mres__card-value {
    font-size: 17px;
    color: rgb(245, 236, 214);
}

.rf-mres__foot {
    flex-direction: row;
}

.rf-mres__saboteurs {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 10px;
    background-color: rgb(30, 27, 22);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-mres__sab-title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.rf-mres .rf-mres__sab-icon {
    font-size: 18px;
    margin-right: 8px;
    color: rgb(236, 80, 64);
}

.rf-mres .rf-mres__sab-heading {
    font-size: 20px;
    color: rgb(245, 236, 214);
}

.rf-mres__sab-list {
    flex-direction: row;
}

.rf-mres__sab {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 10px;
}

.rf-mres__sab--more {
    padding-left: 12px;
    border-left-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.35);
}

.rf-mres .rf-mres__sab-name {
    font-size: 16px;
    color: rgb(245, 236, 214);
}

.rf-mres .rf-mres__sab-what {
    font-size: 14px;
    color: rgb(225, 214, 190);
    white-space: normal;
}

.rf-mres__pot {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 14px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-mres .rf-mres__pot-icon {
    font-size: 30px;
    margin-right: 12px;
    color: rgb(236, 190, 52);
}

.rf-mres .rf-mres__pot-title {
    font-size: 15px;
    color: rgb(245, 236, 214);
}

.rf-mres .rf-mres__pot-coins {
    font-size: 22px;
    color: rgb(255, 214, 90);
}

/* The regatta's standings (MangroveView): every racer in order on the right, what it carries, its lap or time. */
.rf-mstand {
    position: absolute;
    right: 16px;
    top: 200px;
    width: 330px;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(20, 18, 15);
    border-left-width: 3px;
    border-left-color: var(--rf-accent);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.rf-mstand__title {
    font-size: 14px;
    color: var(--rf-text-dim);
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-left: 12px;
    padding-bottom: 4px;
}

.rf-mstand__row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 8px;
    padding-right: 12px;
}

.rf-mstand__row--lead {
    background-color: rgb(52, 40, 22);
}

.rf-mstand__place {
    width: 26px;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--rf-accent);
    -unity-text-align: middle-center;
}

.rf-mstand__name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 17px;
    color: var(--rf-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-left: 6px;
}

.rf-mstand__glyphs {
    font-size: 14px;
    color: var(--rf-accent-bright);
    letter-spacing: 4px;
    margin-left: 6px;
}

.rf-mstand__detail {
    min-width: 64px;
    font-size: 15px;
    color: var(--rf-text-dim);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.rf-mstand__row--done .rf-mstand__detail {
    color: var(--rf-success);
}

/* ---- Talking to Ravebridge's people, 2026-11-02 (RavebridgeDialogueView) ------------------------------------------
   An RPG box along the bottom, above hero mode's skill bar: the NPC's face, their name, the line typing out, numbered
   answers. Solid, so the island does not show through the words. */
.rf-talk {
    position: absolute;
    left: 50%;
    /* above the hero's orbs, their gems the highest (226px), with room to spare */
    bottom: 244px;
    width: 980px;
    margin-left: -490px;
    flex-direction: row;
    align-items: flex-start;
    padding: 16px 18px 14px 16px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-top-width: 3px;
    border-color: var(--rf-border-strong);
    border-top-color: var(--rf-accent);
    border-radius: 10px;
}

/* outside hero mode there is no skill bar under it */
.rf-talk--low {
    bottom: 56px;
}

.rf-talk__face {
    width: 150px;
    height: 150px;
    flex-shrink: 0;
    margin-right: 18px;
    border-width: 2px;
    border-color: var(--rf-accent-dim);
    border-radius: 8px;
    background-color: var(--rf-surface-raised);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.rf-talk__face-letter {
    font-size: 64px;
    color: var(--rf-accent);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-talk__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.rf-talk__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rf-talk__name {
    font-size: 24px;
    color: var(--rf-accent-bright);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-talk__close {
    width: 30px;
    height: 30px;
    font-size: 16px;
    color: var(--rf-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.rf-talk__close:hover {
    color: var(--rf-text);
}

.rf-talk__line {
    margin: 6px 0 12px 0;
    min-height: 56px;
    font-size: 21px;
    color: var(--rf-text);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

.rf-talk__option {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    padding: 7px 12px 7px 8px;
    background-color: var(--rf-surface);
    border-width: 2px;
    border-color: var(--rf-surface);
    border-radius: 6px;
}

.rf-talk__option:hover {
    background-color: var(--rf-surface-raised);
    border-color: var(--rf-accent-dim);
}

.rf-talk__option-key {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    border-radius: 5px;
    background-color: var(--rf-border-strong);
    color: var(--rf-text);
    font-size: 15px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-talk__option-text {
    flex-shrink: 1;
    font-size: 19px;
    color: var(--rf-text);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

/* the quest's own step: gold */
.rf-talk__option--quest .rf-talk__option-key {
    background-color: var(--rf-accent);
    color: var(--rf-text-on-accent);
}

.rf-talk__option--quest .rf-talk__option-text {
    color: var(--rf-accent-bright);
}

/* Goodbye and not now: quieter */
.rf-talk__option--leave .rf-talk__option-text {
    color: var(--rf-text-dim);
}

/* over the box's bottom edge, out of the layout: the box keeps one height while typing and with the answers */
.rf-talk__hint {
    position: absolute;
    right: 0;
    bottom: -13px;
    font-size: 14px;
    color: var(--rf-text-faint);
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

/* "E Talk to Duke Ravacio" floating over the NPC close by */
.rf-talk-prompt {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 4px 12px 4px 4px;
    background-color: var(--rf-bg);
    border-width: 2px;
    border-color: var(--rf-accent-dim);
    border-radius: 6px;
}

.rf-talk-prompt__key {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    border-radius: 4px;
    background-color: var(--rf-accent);
    color: var(--rf-text-on-accent);
    font-size: 15px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20EB.otf?fileID=12800000&guid=808365b70ef7f9f4196179cbde30517a&type=3#FOT-NewRodin Pro EB");
}

.rf-talk-prompt__text {
    font-size: 16px;
    color: var(--rf-text);
    -unity-font-definition: url("project://database/Assets/Fonts/FOT-NewRodin%20Pro%20B.otf?fileID=12800000&guid=ff60cfd97452f864c9a6bf5fc9001f6e&type=3#FOT-NewRodin Pro B");
}

/* ---- Ravebridge's introduction (RavebridgeIntro), 2026-11-03: a modern game's tutorial window over a dimmed screen --- */
.rf-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 5, 4, 0.62);
}

.rf-intro__panel {
    width: 1240px;
    overflow: hidden;
    background-color: rgb(20, 18, 15);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.rf-intro__media {
    height: 600px;
    overflow: hidden;
    background-color: rgb(34, 30, 24);
}

/* a little bigger than its frame, so the slow drift never shows an edge */
.rf-intro__picture {
    position: absolute;
    left: -5%;
    top: -5%;
    width: 110%;
    height: 110%;
    -unity-background-scale-mode: scale-and-crop;
}

.rf-intro__shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    -unity-background-scale-mode: stretch-to-fill;
}

.rf-intro .rf-intro__counter {
    position: absolute;
    left: 24px;
    top: 22px;
    padding: 4px 12px;
    font-size: 16px;
    color: rgb(245, 236, 214);
    background-color: rgba(20, 18, 15, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.8);
    border-right-color: rgba(214, 170, 40, 0.8);
    border-top-color: rgba(214, 170, 40, 0.8);
    border-bottom-color: rgba(214, 170, 40, 0.8);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rf-intro .rf-intro__close {
    position: absolute;
    right: 18px;
    top: 16px;
    width: 44px;
    height: 44px;
    font-size: 20px;
    color: rgb(245, 236, 214);
    background-color: rgba(20, 18, 15, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.8);
    border-right-color: rgba(214, 170, 40, 0.8);
    border-top-color: rgba(214, 170, 40, 0.8);
    border-bottom-color: rgba(214, 170, 40, 0.8);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.rf-intro .rf-intro__close:hover {
    color: rgb(255, 214, 90);
    background-color: rgb(40, 32, 18);
}

.rf-intro__body {
    /* the same height on every page, so Back and Next stay put */
    min-height: 236px;
    padding: 6px 48px 8px 48px;
}

.rf-intro .rf-intro__eyebrow {
    font-size: 17px;
    letter-spacing: 3px;
    color: rgb(236, 190, 52);
}

.rf-intro .rf-intro__title {
    margin-top: 2px;
    font-size: 46px;
    color: rgb(245, 236, 214);
}

.rf-intro .rf-intro__text {
    margin-top: 8px;
    font-size: 23px;
    color: rgb(225, 214, 190);
    white-space: normal;
}

.rf-intro__keys {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.rf-intro__key {
    flex-direction: row;
    align-items: center;
    margin: 0 12px 8px 0;
    padding: 5px 14px 5px 5px;
    background-color: rgb(30, 27, 22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(214, 170, 40, 0.6);
    border-right-color: rgba(214, 170, 40, 0.6);
    border-top-color: rgba(214, 170, 40, 0.6);
    border-bottom-color: rgba(214, 170, 40, 0.6);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.rf-intro .rf-intro__keycap {
    min-width: 34px;
    padding: 3px 10px;
    margin-right: 10px;
    font-size: 17px;
    -unity-text-align: middle-center;
    color: rgb(245, 236, 214);
    background-color: rgb(44, 38, 30);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-intro .rf-intro__keytext {
    font-size: 18px;
    color: rgb(235, 225, 200);
}

.rf-intro__foot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 48px 34px 48px;
}

.rf-intro__dots {
    flex-direction: row;
    align-items: center;
}

.rf-intro__dot {
    width: 12px;
    height: 12px;
    margin-right: 10px;
    background-color: rgba(214, 170, 40, 0.3);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.rf-intro__dot:hover {
    background-color: rgba(214, 170, 40, 0.6);
}

.rf-intro__dot--on {
    width: 34px;
    background-color: rgb(236, 190, 52);
}

.rf-intro__buttons {
    flex-direction: row;
}

.rf-intro .rf-intro__button {
    height: 52px;
    min-width: 150px;
    margin-left: 12px;
    padding: 0 26px;
    font-size: 20px;
    color: rgb(236, 190, 52);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(214, 170, 40);
    border-right-color: rgb(214, 170, 40);
    border-top-color: rgb(214, 170, 40);
    border-bottom-color: rgb(214, 170, 40);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.rf-intro .rf-intro__button:hover {
    background-color: rgba(214, 170, 40, 0.15);
}

.rf-intro .rf-intro__button--primary {
    color: rgb(20, 18, 15);
    background-color: rgb(236, 190, 52);
}

.rf-intro .rf-intro__button--primary:hover {
    background-color: rgb(255, 214, 90);
}
